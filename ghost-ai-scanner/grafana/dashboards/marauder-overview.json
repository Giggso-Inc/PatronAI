  "panels": [
    {
      "type": "stat",
      "title": "Total Events (today)",
      "datasource": {
        "type": "marcusolsson-json-datasource",
        "uid": "patronai-summary"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "marcusolsson-json-datasource",
            "uid": "patronai-summary"
          },
          "urlPath": "/summary/daily/${__to:date:YYYY-MM-DD}.json",
          "method": "GET",
          "queryParams": "",
          "cacheDurationSeconds": 60,
          "fields": [
            {
              "jsonPath": "$.total_events",
              "name": "Total events",
              "type": "number"
            }
          ]
        }
      ]
    },
