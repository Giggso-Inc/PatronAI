# =============================================================
# PatronAI — Agent Installer (Windows PowerShell)
# Generated for: {{RECIPIENT_NAME}} <{{RECIPIENT_EMAIL}}>
# Token: {{TOKEN}}
# Expires: {{EXPIRES_AT}}
#
# USAGE: powershell -ExecutionPolicy Bypass -File setup_agent.ps1
# REQUIRES: PowerShell 5.1+, Python 3 (with bcrypt installed)
#
# NOTE ON NON-ASCII CHARACTERS: this raw template file has no UTF-8 BOM
# (source-controlled text). Windows PowerShell 5.1 falls back to the system
# ANSI codepage when reading a script with no BOM, which can misread a
# multi-byte UTF-8 character (e.g. an em-dash) inside a double-quoted string
# and corrupt the rest of the parse - confirmed live against this exact file
# with [System.Management.Automation.Language.Parser]::ParseFile(). The
# actual SHIPPED installer is unaffected: render_agent_package.py re-encodes
# the rendered output as utf-8-sig (BOM) before upload specifically because
# of this issue (see that file's v1.6.1 changelog). Comments are free to use
# em-dashes/curly quotes/etc. (the parser ignores comment content either
# way) - but any string literal actually reachable by PowerShell's tokenizer
# (Write-Host/Write-Info calls, variable values) MUST stay plain ASCII here,
# so this template is also correctly parseable on its own without depending
# on that downstream BOM re-encoding step.
# =============================================================
$ErrorActionPreference = "Stop"

$MetaUrl           = "{{META_URL}}"
$StatusPutUrl      = "{{STATUS_PUT_URL}}"
$HeartbeatPutUrl   = "{{HEARTBEAT_PUT_URL}}"
$ScanPutUrl        = "{{SCAN_PUT_URL}}"
$AuthorizedGetUrl  = "{{AUTHORIZED_GET_URL}}"
$UrlsRefreshUrl    = "{{URLS_REFRESH_URL}}"
$AuthorizedDomains = "{{AUTHORIZED_DOMAINS}}"
$Bucket            = "{{BUCKET}}"
$Region            = "{{REGION}}"
$Company           = "{{COMPANY}}"
$Token             = "{{TOKEN}}"
$RecipientName     = "{{RECIPIENT_NAME}}"
$RecipientEmail    = "{{RECIPIENT_EMAIL}}"
$AgentVersion      = "{{AGENT_VERSION}}"

$AgentDir   = Join-Path $env:USERPROFILE ".patronai"
$ConfigPath = Join-Path $AgentDir "config.json"

function Write-Info($msg) { Write-Host "[patronai] $msg" }
function Write-Fail($msg) { Write-Host "ERROR: $msg" -ForegroundColor Red; exit 1 }

# ── Validate python3 / bcrypt ─────────────────────────────────
try { python --version *>$null } catch { Write-Fail "Python 3 is required. Install from python.org" }
$bcryptOk = python -c "import bcrypt; print('ok')" 2>$null
if ($bcryptOk -ne "ok") {
    Write-Info "Installing bcrypt..."
    pip install --quiet "bcrypt>=4.0.0" | Out-Null
}

# ── Prompt for OTP (accepts non-interactive OTP via env var) ─
# Standalone installs prompt, exactly as before. When invoked by
# Raven's installer, $env:PATRONAI_OTP is the SAME 6-digit code the
# user typed into Raven; Raven Hub has already mirrored that code
# into this package's meta.json bcrypt hash (via /agent/provision
# otp_override), so the same validation below still runs — no trust
# flag, no bypass. Attacker with only the .ps1 cannot install.
Write-Host ""
Write-Host "PatronAI Agent Installer"
Write-Host "========================"
Write-Host "Recipient : $RecipientName"
Write-Host "Company   : $Company"
Write-Host ""

if ($env:PATRONAI_OTP) {
    $OtpInput = $env:PATRONAI_OTP
    Write-Info "Using OTP passed by caller (non-interactive)."
} else {
    $OtpInput = Read-Host "Enter your 6-digit installation OTP"
}

if ($OtpInput -notmatch '^\d{6}$') {
    Write-Fail "OTP must be exactly 6 digits."
}

# ── Download and validate meta ────────────────────────────────
Write-Info "Validating OTP..."
$TmpMeta = Join-Path $env:TEMP "patronai-meta-$Token.json"
try {
    Invoke-WebRequest -Uri $MetaUrl -OutFile $TmpMeta -TimeoutSec 30
} catch {
    Write-Fail "Cannot reach installation server. URL may have expired."
}

$OtpHash = python -c "import json; print(json.load(open(r'$TmpMeta'))['otp_hash'])"
$Expires  = python -c "import json; print(json.load(open(r'$TmpMeta'))['expires_at'])"

$Expired = python -c @"
from datetime import datetime, timezone
e = datetime.fromisoformat('$Expires')
print('yes' if datetime.now(timezone.utc) > e else 'no')
"@
if ($Expired -eq "yes") { Write-Fail "Installation package has expired. Request a new one." }

$Valid = python -c @"
import bcrypt
try:
    ok = bcrypt.checkpw(b'$OtpInput', b'$OtpHash')
    print('yes' if ok else 'no')
except Exception:
    print('no')
"@
if ($Valid -ne "yes") { Write-Fail "Invalid OTP. Please check your email and try again." }
Write-Info "OTP validated."

# ── Install agent files (identity baked at install) ──────────
New-Item -ItemType Directory -Force -Path $AgentDir | Out-Null

# Compute MAC + device_uuid once, then persist alongside token/email.
$DeviceUuid  = [guid]::NewGuid().ToString()
$MacPrimary  = (Get-NetAdapter | Where-Object Status -eq "Up" | Select-Object -First 1 -ExpandProperty MacAddress) -replace "-", ":"
if (-not $MacPrimary) { $MacPrimary = "00:00:00:00:00:00" }

$Config = @{
    bucket      = $Bucket
    region      = $Region
    company     = $Company
    token       = $Token
    email       = $RecipientEmail
    device_uuid = $DeviceUuid
    mac_primary = $MacPrimary.ToLower()
    agent_dir   = $AgentDir
} | ConvertTo-Json
$Config | Set-Content -Path $ConfigPath -Encoding UTF8

# Persist presigned URLs + URL-refresh endpoint + authorised list fallback.
$HeartbeatPutUrl   | Set-Content -Path (Join-Path $AgentDir "heartbeat_url.txt")      -Encoding UTF8
$ScanPutUrl        | Set-Content -Path (Join-Path $AgentDir "scan_url.txt")            -Encoding UTF8
$AuthorizedGetUrl  | Set-Content -Path (Join-Path $AgentDir "authorized_url.txt")      -Encoding UTF8
$UrlsRefreshUrl    | Set-Content -Path (Join-Path $AgentDir "urls_refresh_url.txt")    -Encoding UTF8

# agent_version.txt — read by heartbeat.ps1 at runtime instead of a version
# string frozen into heartbeat.ps1 itself, so apply_update.ps1 can bump it
# later by rewriting just this one file.
$AgentVersion      | Set-Content -Path (Join-Path $AgentDir "agent_version.txt")       -Encoding UTF8

# Local action log (one JSON-line per PUT). Replaces silent failure.
New-Item -ItemType File -Force -Path (Join-Path $AgentDir "agent.log") | Out-Null
$AuthorizedDomains | Set-Content -Path (Join-Path $AgentDir "authorized_domains.txt")  -Encoding UTF8

# Phase 1A — first-run flag. scan_first_run.py.frag reads it (IS_FIRST_RUN);
# the footer clears it after a successful payload print so subsequent scans
# run in lighter recurring mode.
New-Item -ItemType File -Force -Path (Join-Path $AgentDir "first_run.flag") | Out-Null

# ── Write pre-commit hook script ──────────────────────────────
# Source lives at agent/install/pre_commit_hook.ps1 and is inlined verbatim
# at render time (same INLINE_* pattern as diagnose.ps1 below) - extracted
# out of this file so build_agent_update_bundle.py can ship it as part of a
# self-update bundle without parsing this template's own here-strings.
$HookScript = Join-Path $AgentDir "pre_commit_hook.ps1"
@'
{{INLINE_PRE_COMMIT_HOOK_PS1}}
'@ | Set-Content -Path $HookScript -Encoding UTF8

# ── Hook-chain library (chain-aware pre-commit install) ──────
# Never clobber a pre-existing hook. Preserve it as
# pre-commit.pre-patronai and install a small chain shim that runs
# the preserved hook first, then PatronAI's PowerShell hook. Git for
# Windows runs sh.exe, so the chain shim body is a shell script even
# on Windows — same content as the Linux/macOS chain. Idempotent:
# safe to re-run from the heartbeat backstop.
$ChainLib = Join-Path $AgentDir "hook_chain.ps1"
# Source lives at agent/install/hook_chain.ps1, inlined verbatim at render
# time - extracted for the same reason as pre_commit_hook.ps1 above.
$ChainLibBody = @'
{{INLINE_HOOK_CHAIN_PS1}}
'@
$ChainLibBody | Set-Content -Path $ChainLib -Encoding UTF8

# ── Auto-install into git repos under user profile (chain-aware) ─
. $ChainLib
$InstallCount = 0
Get-ChildItem -Path $env:USERPROFILE -Recurse -Depth 4 -Filter ".git" -Directory -ErrorAction SilentlyContinue | ForEach-Object {
    $HooksDir = Join-Path $_.FullName "hooks"
    if (Install-PatronAIChainHook -HooksDir $HooksDir) { $InstallCount++ }
}

# Step 0.1 — git template dir (auto-install on every future init/clone).
# Honours an existing init.templateDir if one is already set (additive).
$TemplateDir   = Join-Path $AgentDir "git-template"
$TemplateHooks = Join-Path $TemplateDir "hooks"
$ExistingTpl   = (& git config --global --get init.templateDir 2>$null)
if ($ExistingTpl -and $ExistingTpl -ne $TemplateDir) {
    $Expanded = $ExistingTpl -replace '^~', $env:USERPROFILE
    $TgtHooks = Join-Path $Expanded "hooks"
    New-Item -ItemType Directory -Force -Path $TgtHooks | Out-Null
    # Copy the already-written hook file directly rather than an undefined
    # $HookBody variable (pre-existing bug: this branch used to write an
    # EMPTY pre-commit hook into an existing init.templateDir).
    Copy-Item -Path $HookScript -Destination (Join-Path $TgtHooks "pre-commit") -Force
    Write-Info "init.templateDir preserved ($ExistingTpl); hook copied alongside."
} else {
    New-Item -ItemType Directory -Force -Path $TemplateHooks | Out-Null
    Copy-Item -Path $HookScript -Destination (Join-Path $TemplateHooks "pre-commit") -Force
    & git config --global init.templateDir $TemplateDir | Out-Null
    Write-Info "init.templateDir set - every new git init/clone gets the hook."
}

# ── Write endpoint scan script ────────────────────────────────
# Runs every 30 min. Multi-surface: packages, processes, browsers,
# IDE plugins, containers (image+logs), shell history. Scan logic
# lives in agent/install/scan_*.py.frag — same Python is inlined
# into agent/install/scan.ps1 at render time (render_agent_package.py
# resolves scan.ps1's own {{INLINE_SCAN_PYTHON}} placeholder BEFORE this
# outer substitution pass, since a nested {{...}} inside a substituted
# value is not re-scanned by the same pass — see that file's comment).
# scan.ps1 is extracted to its own file for the same reason
# pre_commit_hook.ps1/hook_chain.ps1 are above.
$ScanScript = Join-Path $AgentDir "scan.ps1"
@'
{{INLINE_SCAN_PS1}}
'@ | Set-Content -Path $ScanScript -Encoding UTF8

# ── Report install status ─────────────────────────────────────
$StatusPayload = @{
    token        = $Token
    status       = "installed"
    device_id    = $env:COMPUTERNAME
    installed_at = (Get-Date -Format "yyyy-MM-ddTHH:mm:ssZ")
} | ConvertTo-Json -Compress

try {
    Invoke-WebRequest -Uri $StatusPutUrl -Method Put -Body $StatusPayload `
        -ContentType "application/json" -TimeoutSec 15 | Out-Null
} catch { <# non-fatal #> }

# ── Write heartbeat script (URL refresh + identity + structured log) ──
# Source lives at agent/install/heartbeat.ps1, inlined verbatim at render
# time - extracted for the same reason as the scripts above.
$HeartbeatScript = Join-Path $AgentDir "heartbeat.ps1"
@'
{{INLINE_HEARTBEAT_PS1}}
'@ | Set-Content -Path $HeartbeatScript -Encoding UTF8

# ── Write self-update script ──────────────────────────────────
# Runs hourly, separate from the 5-min heartbeat above that only NOTICES an
# update (writes pending_update.json) - applying it is a separate, lower-
# frequency task so a scheduled heartbeat run can never read this same
# heartbeat.ps1 file half-replaced out from under itself. Source lives at
# agent/install/apply_update.ps1 and is inlined verbatim at render time -
# same INLINE_* pattern as diagnose.ps1 below.
$ApplyUpdateScript = Join-Path $AgentDir "apply_update.ps1"
@'
{{INLINE_APPLY_UPDATE_PS1}}
'@ | Set-Content -Path $ApplyUpdateScript -Encoding UTF8

# ── Hidden-launch shim ────────────────────────────────────────
# Task Scheduler invoking powershell.exe directly still briefly flashes a
# console window on many Windows builds even with -WindowStyle Hidden — the
# OS allocates a console host before PowerShell's own startup code can apply
# that style. WScript.Shell.Run with windowStyle=0 suppresses the window at
# process-creation time instead, so nothing ever flashes on screen. Every 5
# minutes was visibly popping a window; this is the fix.
# ACCEPTED RISK (PR#10 review, N1): a wscript.exe + WScript.Shell.Run hidden
# launcher is a pattern AV/EDR heuristics sometimes flag, since it's also a
# known living-off-the-land technique — ironic for a security product. If
# quarantined, the Scheduled Tasks silently stop firing with no error in the
# install log. Accepted for now over the added infra of a compiled/signed
# launcher; add an AV-exclusion note to the install runbook if this bites.
$HiddenLauncher = Join-Path $AgentDir "run_hidden.vbs"
@'
Dim shell, cmd
Set shell = CreateObject("WScript.Shell")
cmd = "powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File " & Chr(34) & WScript.Arguments(0) & Chr(34)
shell.Run cmd, 0, False
'@ | Set-Content -Path $HiddenLauncher -Encoding ASCII

# ── Register Task Scheduler tasks ────────────────────────────
function Register-PatronAITask($TaskName, $ScriptPath, $IntervalMinutes, $Desc) {
    $Action   = New-ScheduledTaskAction -Execute "wscript.exe" `
        -Argument "//B `"$HiddenLauncher`" `"$ScriptPath`""
    $Trigger  = New-ScheduledTaskTrigger -RepetitionInterval (New-TimeSpan -Minutes $IntervalMinutes) `
        -Once -At (Get-Date)
    $Settings = New-ScheduledTaskSettingsSet -ExecutionTimeLimit (New-TimeSpan -Minutes 2) `
        -StartWhenAvailable -DontStopIfGoingOnBatteries -RunOnlyIfNetworkAvailable -Hidden
    try {
        Unregister-ScheduledTask -TaskName $TaskName -Confirm:$false -ErrorAction SilentlyContinue
        Register-ScheduledTask -TaskName $TaskName -Action $Action -Trigger $Trigger `
            -Settings $Settings -Description $Desc -RunLevel Limited | Out-Null
        Write-Info "$TaskName registered (every $IntervalMinutes min)."
    } catch {
        Write-Info "$TaskName registration failed: $_"
    }
}

Register-PatronAITask "PatronAI-Heartbeat" $HeartbeatScript 5  "PatronAI liveness heartbeat"
Register-PatronAITask "PatronAI-Scan"      $ScanScript      30 "PatronAI endpoint scan (packages/processes/browser)"
Register-PatronAITask "PatronAI-Update"    $ApplyUpdateScript 60 "PatronAI agent self-update"

# Run first scan immediately in background
Start-Process wscript.exe -ArgumentList "//B `"$HiddenLauncher`" `"$ScanScript`""

Remove-Item -Path $TmpMeta -ErrorAction SilentlyContinue

# ── Drop the recipient-side diagnose script ──────────────────
$Diag = Join-Path $AgentDir "diagnose.ps1"
@'
{{INLINE_DIAGNOSE_PS1}}
'@ | Set-Content -Path $Diag -Encoding UTF8

Write-Host ""
Write-Info "Installation complete."
Write-Info "Pre-commit hook installed in $InstallCount existing repositories."
Write-Info "New repos auto-instrumented via init.templateDir - no manual step needed."
Write-Info "Endpoint scan every 30 min - packages, processes, browsers, IDE plugins, containers, shell history,"
Write-Info "                              MCP servers, agent workflows, scheduled agents, tool registrations, vector DBs."
Write-Info "First scan runs in baseline mode (wider walk); subsequent scans run lighter."
Write-Info "Heartbeat every 5 min - refreshes presigned URLs AND auto-installs the pre-commit hook"
Write-Info "                       in any new git repo cloned/init-ed since the last cycle."
Write-Info "AI framework signals in git commits will be forwarded for analysis."
Write-Info "If anything looks off later, run:  powershell -File ~/.patronai/diagnose.ps1"
