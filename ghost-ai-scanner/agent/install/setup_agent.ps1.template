# =============================================================
# PatronAI — Agent Installer (Windows PowerShell)
# Generated for: {{RECIPIENT_NAME}} <{{RECIPIENT_EMAIL}}>
# Token: {{TOKEN}}
# Expires: {{EXPIRES_AT}}
#
# USAGE: powershell -ExecutionPolicy Bypass -File setup_agent.ps1
# REQUIRES: PowerShell 5.1+, Python 3 (with bcrypt installed)
# =============================================================
$ErrorActionPreference = "Stop"

$MetaUrl           = "{{META_URL}}"
$StatusPutUrl      = "{{STATUS_PUT_URL}}"
$HeartbeatPutUrl   = "{{HEARTBEAT_PUT_URL}}"
$ScanPutUrl        = "{{SCAN_PUT_URL}}"
$AuthorizedGetUrl  = "{{AUTHORIZED_GET_URL}}"
$UrlsRefreshUrl    = "{{URLS_REFRESH_URL}}"
$AuthorizedDomains = "{{AUTHORIZED_DOMAINS}}"
$Bucket            = "{{BUCKET}}"
$Region            = "{{REGION}}"
$Company           = "{{COMPANY}}"
$Token             = "{{TOKEN}}"
$RecipientName     = "{{RECIPIENT_NAME}}"
$RecipientEmail    = "{{RECIPIENT_EMAIL}}"

$AgentDir   = Join-Path $env:USERPROFILE ".patronai"
$ConfigPath = Join-Path $AgentDir "config.json"

function Write-Info($msg) { Write-Host "[patronai] $msg" }
function Write-Fail($msg) { Write-Host "ERROR: $msg" -ForegroundColor Red; exit 1 }

# ── Validate python3 / bcrypt ─────────────────────────────────
try { python --version *>$null } catch { Write-Fail "Python 3 is required. Install from python.org" }
$bcryptOk = python -c "import bcrypt; print('ok')" 2>$null
if ($bcryptOk -ne "ok") {
    Write-Info "Installing bcrypt..."
    pip install --quiet "bcrypt>=4.0.0" | Out-Null
}

# ── Prompt for OTP (accepts non-interactive OTP via env var) ─
# Standalone installs prompt, exactly as before. When invoked by
# Raven's installer, $env:PATRONAI_OTP is the SAME 6-digit code the
# user typed into Raven; Raven Hub has already mirrored that code
# into this package's meta.json bcrypt hash (via /agent/provision
# otp_override), so the same validation below still runs — no trust
# flag, no bypass. Attacker with only the .ps1 cannot install.
Write-Host ""
Write-Host "PatronAI Agent Installer"
Write-Host "========================"
Write-Host "Recipient : $RecipientName"
Write-Host "Company   : $Company"
Write-Host ""

if ($env:PATRONAI_OTP) {
    $OtpInput = $env:PATRONAI_OTP
    Write-Info "Using OTP passed by caller (non-interactive)."
} else {
    $OtpInput = Read-Host "Enter your 6-digit installation OTP"
}

if ($OtpInput -notmatch '^\d{6}$') {
    Write-Fail "OTP must be exactly 6 digits."
}

# ── Download and validate meta ────────────────────────────────
Write-Info "Validating OTP..."
$TmpMeta = Join-Path $env:TEMP "patronai-meta-$Token.json"
try {
    Invoke-WebRequest -Uri $MetaUrl -OutFile $TmpMeta -TimeoutSec 30
} catch {
    Write-Fail "Cannot reach installation server. URL may have expired."
}

$OtpHash = python -c "import json; print(json.load(open(r'$TmpMeta'))['otp_hash'])"
$Expires  = python -c "import json; print(json.load(open(r'$TmpMeta'))['expires_at'])"

$Expired = python -c @"
from datetime import datetime, timezone
e = datetime.fromisoformat('$Expires')
print('yes' if datetime.now(timezone.utc) > e else 'no')
"@
if ($Expired -eq "yes") { Write-Fail "Installation package has expired. Request a new one." }

$Valid = python -c @"
import bcrypt
try:
    ok = bcrypt.checkpw(b'$OtpInput', b'$OtpHash')
    print('yes' if ok else 'no')
except Exception:
    print('no')
"@
if ($Valid -ne "yes") { Write-Fail "Invalid OTP. Please check your email and try again." }
Write-Info "OTP validated."

# ── Install agent files (identity baked at install) ──────────
New-Item -ItemType Directory -Force -Path $AgentDir | Out-Null

# Compute MAC + device_uuid once, then persist alongside token/email.
$DeviceUuid  = [guid]::NewGuid().ToString()
$MacPrimary  = (Get-NetAdapter | Where-Object Status -eq "Up" | Select-Object -First 1 -ExpandProperty MacAddress) -replace "-", ":"
if (-not $MacPrimary) { $MacPrimary = "00:00:00:00:00:00" }

$Config = @{
    bucket      = $Bucket
    region      = $Region
    company     = $Company
    token       = $Token
    email       = $RecipientEmail
    device_uuid = $DeviceUuid
    mac_primary = $MacPrimary.ToLower()
    agent_dir   = $AgentDir
} | ConvertTo-Json
$Config | Set-Content -Path $ConfigPath -Encoding UTF8

# Persist presigned URLs + URL-refresh endpoint + authorised list fallback.
$HeartbeatPutUrl   | Set-Content -Path (Join-Path $AgentDir "heartbeat_url.txt")      -Encoding UTF8
$ScanPutUrl        | Set-Content -Path (Join-Path $AgentDir "scan_url.txt")            -Encoding UTF8
$AuthorizedGetUrl  | Set-Content -Path (Join-Path $AgentDir "authorized_url.txt")      -Encoding UTF8
$UrlsRefreshUrl    | Set-Content -Path (Join-Path $AgentDir "urls_refresh_url.txt")    -Encoding UTF8

# Local action log (one JSON-line per PUT). Replaces silent failure.
New-Item -ItemType File -Force -Path (Join-Path $AgentDir "agent.log") | Out-Null
$AuthorizedDomains | Set-Content -Path (Join-Path $AgentDir "authorized_domains.txt")  -Encoding UTF8

# Phase 1A — first-run flag. scan_first_run.py.frag reads it (IS_FIRST_RUN);
# the footer clears it after a successful payload print so subsequent scans
# run in lighter recurring mode.
New-Item -ItemType File -Force -Path (Join-Path $AgentDir "first_run.flag") | Out-Null

# ── Write pre-commit hook script ──────────────────────────────
$HookScript = Join-Path $AgentDir "pre_commit_hook.ps1"
@'
# PatronAI pre-commit hook — PowerShell
$ConfigPath = Join-Path $env:USERPROFILE ".patronai\config.json"
if (-not (Test-Path $ConfigPath)) { exit 0 }
$Cfg    = Get-Content $ConfigPath | ConvertFrom-Json
$Bucket = $Cfg.bucket; $Region = $Cfg.region; $Company = $Cfg.company
if (-not $Bucket) { exit 0 }
$Diff = git diff --cached --unified=3 2>$null
if (-not $Diff) { exit 0 }
$Signals = "langchain|llama_index|autogen|crewai|openai\.agents|MCPServer|api\.openai\.com|sk-proj-|sk-ant-"
if (-not ($Diff -match $Signals)) { exit 0 }
$DeviceId  = $env:COMPUTERNAME
$Timestamp = (Get-Date -Format "yyyy-MM-ddTHH:mm:ssZ")
$Repo      = Split-Path -Leaf (git rev-parse --show-toplevel 2>$null)
$Branch    = git rev-parse --abbrev-ref HEAD 2>$null
$Snippet   = $Diff.Substring(0, [Math]::Min($Diff.Length, 5120))
$Payload   = @{event_type="GIT_DIFF_SIGNAL";source="patronai_git_hook_ps";
               device_id=$DeviceId;company=$Company;repo=$Repo;branch=$Branch;
               timestamp=$Timestamp;diff_snippet=$Snippet} | ConvertTo-Json -Compress
$Key = "ocsf/agent/git-diffs/$DeviceId-$Timestamp.json"
aws s3 cp - "s3://$Bucket/$Key" --region $Region --content-type "application/json" --quiet 2>$null
exit 0
'@ | Set-Content -Path $HookScript -Encoding UTF8

# ── Hook-chain library (chain-aware pre-commit install) ──────
# Never clobber a pre-existing hook. Preserve it as
# pre-commit.pre-patronai and install a small chain shim that runs
# the preserved hook first, then PatronAI's PowerShell hook. Git for
# Windows runs sh.exe, so the chain shim body is a shell script even
# on Windows — same content as the Linux/macOS chain. Idempotent:
# safe to re-run from the heartbeat backstop.
$ChainLib = Join-Path $AgentDir "hook_chain.ps1"
$ChainLibBody = @'
# PatronAI hook-chain library (PowerShell). Loaded from setup and heartbeat.
function Install-PatronAIChainHook {
    param([Parameter(Mandatory)][string]$HooksDir)

    $HookScript  = Join-Path $env:USERPROFILE ".patronai\pre_commit_hook.ps1"
    $HookPath    = Join-Path $HooksDir "pre-commit"
    $Preserved   = Join-Path $HooksDir "pre-commit.pre-patronai"
    $Marker      = "PatronAI managed pre-commit chain"

    if (-not (Test-Path $HookScript)) { return $false }
    if (-not (Test-Path $HooksDir))   { New-Item -ItemType Directory -Path $HooksDir | Out-Null }

    if (Test-Path $HookPath) {
        try {
            $existing = Get-Content $HookPath -Raw -ErrorAction Stop
        } catch { $existing = "" }
        if ($existing -match $Marker) {
            return $true  # chain already present — idempotent no-op
        }
        # Legacy PatronAI shim from a pre-chain install? Detect by known
        # 2-line signature and drop it — nothing worth preserving.
        $legacy = "#!/bin/sh`npowershell -ExecutionPolicy Bypass -File `"$HookScript`""
        if (($existing -replace "`r","") -eq ($legacy -replace "`r","")) {
            Remove-Item $HookPath -Force
        } else {
            # Real hook from Raven / husky / user — always preserve it,
            # overwriting any older preserved copy. If husky (or the
            # user) reinstalls its hook after the chain is already in
            # place, the second pass sees the fresh real hook back at
            # $HookPath and MUST keep it — dropping it here would
            # silently strand whatever changed in the reinstall and
            # keep running the stale first-generation preserved copy.
            Move-Item $HookPath $Preserved -Force
        }
    }

    $ChainBody = @"
#!/bin/sh
# PatronAI managed pre-commit chain — DO NOT EDIT.
HOOK_DIR="`$(cd "`$(dirname "`$0")" && pwd)"
if [ -x "`$HOOK_DIR/pre-commit.pre-patronai" ]; then
    "`$HOOK_DIR/pre-commit.pre-patronai" "`$@" || exit `$?
fi
powershell -ExecutionPolicy Bypass -File "$HookScript"
"@
    $ChainBody | Set-Content -Path $HookPath -Encoding UTF8
    return $true
}
'@
$ChainLibBody | Set-Content -Path $ChainLib -Encoding UTF8

# ── Auto-install into git repos under user profile (chain-aware) ─
. $ChainLib
$InstallCount = 0
Get-ChildItem -Path $env:USERPROFILE -Recurse -Depth 4 -Filter ".git" -Directory -ErrorAction SilentlyContinue | ForEach-Object {
    $HooksDir = Join-Path $_.FullName "hooks"
    if (Install-PatronAIChainHook -HooksDir $HooksDir) { $InstallCount++ }
}

# Step 0.1 — git template dir (auto-install on every future init/clone).
# Honours an existing init.templateDir if one is already set (additive).
$TemplateDir   = Join-Path $AgentDir "git-template"
$TemplateHooks = Join-Path $TemplateDir "hooks"
$ExistingTpl   = (& git config --global --get init.templateDir 2>$null)
if ($ExistingTpl -and $ExistingTpl -ne $TemplateDir) {
    $Expanded = $ExistingTpl -replace '^~', $env:USERPROFILE
    $TgtHooks = Join-Path $Expanded "hooks"
    New-Item -ItemType Directory -Force -Path $TgtHooks | Out-Null
    $HookBody | Set-Content -Path (Join-Path $TgtHooks "pre-commit") -Encoding UTF8
    Write-Info "init.templateDir preserved ($ExistingTpl); hook copied alongside."
} else {
    New-Item -ItemType Directory -Force -Path $TemplateHooks | Out-Null
    $HookBody | Set-Content -Path (Join-Path $TemplateHooks "pre-commit") -Encoding UTF8
    & git config --global init.templateDir $TemplateDir | Out-Null
    Write-Info "init.templateDir set — every new git init/clone gets the hook."
}

# ── Write endpoint scan script ────────────────────────────────
# Runs every 30 min. Multi-surface: packages, processes, browsers,
# IDE plugins, containers (image+logs), shell history. Scan logic
# lives in agent/install/scan_*.py.frag — same Python is inlined
# into the bash and PowerShell installers at render time (see scan_*.py.frag).
# NOTE: never write the literal INLINE_SCAN_PYTHON placeholder token in a
# comment — agent_renderer.py does a blind global substitution of every
# {{...}} match in the file, so a second accidental occurrence gets the
# entire multi-line Python source dropped into it too, unquoted, breaking
# the parser. The one real placeholder for this is a few lines below.
$ScanScript = Join-Path $AgentDir "scan.ps1"
@'
$AgentDir    = Join-Path $env:USERPROFILE ".patronai"
$ConfigPath  = Join-Path $AgentDir "config.json"
$ScanUrlFile = Join-Path $AgentDir "scan_url.txt"
if (-not (Test-Path $ConfigPath))  { exit 0 }
if (-not (Test-Path $ScanUrlFile)) { exit 0 }
$ScanUrl = (Get-Content $ScanUrlFile).Trim()
if (-not $ScanUrl) { exit 0 }
$Cfg     = Get-Content $ConfigPath | ConvertFrom-Json

# Refresh live authorised list (presigned GET; admin-editable without reinstall).
$AuthUrlFile = Join-Path $AgentDir "authorized_url.txt"
if (Test-Path $AuthUrlFile) {
    $AuthGetUrl = (Get-Content $AuthUrlFile).Trim()
    if ($AuthGetUrl) {
        try {
            $Live = Invoke-WebRequest -Uri $AuthGetUrl -TimeoutSec 10 -UseBasicParsing
            if ($Live.Content) {
                $Live.Content | Set-Content -Path (Join-Path $AgentDir "authorized_domains.txt") -Encoding UTF8
            }
        } catch { <# fallback to local file #> }
    }
}

# Pass token + company into the embedded Python via env so $TOKEN/$COMPANY
# placeholders in scan_header.py.frag bind to the live values.
$env:PATRONAI_TOKEN   = $Cfg.token
$env:PATRONAI_COMPANY = $Cfg.company
$Result = python -c @"
{{INLINE_SCAN_PYTHON}}
"@

if ($Result) {
    try {
        Invoke-WebRequest -Uri $ScanUrl -Method Put -Body $Result `
            -ContentType "application/json" -TimeoutSec 30 | Out-Null
    } catch { <# non-fatal #> }
}
'@ | Set-Content -Path $ScanScript -Encoding UTF8

# ── Report install status ─────────────────────────────────────
$StatusPayload = @{
    token        = $Token
    status       = "installed"
    device_id    = $env:COMPUTERNAME
    installed_at = (Get-Date -Format "yyyy-MM-ddTHH:mm:ssZ")
} | ConvertTo-Json -Compress

try {
    Invoke-WebRequest -Uri $StatusPutUrl -Method Put -Body $StatusPayload `
        -ContentType "application/json" -TimeoutSec 15 | Out-Null
} catch { <# non-fatal #> }

# ── Write heartbeat script (URL refresh + identity + structured log) ──
$HeartbeatScript = Join-Path $AgentDir "heartbeat.ps1"
@'
$AgentDir    = Join-Path $env:USERPROFILE ".patronai"
$ConfigPath  = Join-Path $AgentDir "config.json"
$UrlFile     = Join-Path $AgentDir "heartbeat_url.txt"
$RefreshFile = Join-Path $AgentDir "urls_refresh_url.txt"
$Log         = Join-Path $AgentDir "agent.log"
if (-not (Test-Path $ConfigPath)) { exit 0 }
$Cfg = Get-Content $ConfigPath | ConvertFrom-Json

# 1. Refresh URLs from urls.json (best-effort).
if (Test-Path $RefreshFile) {
    $RefreshUrl = (Get-Content $RefreshFile).Trim()
    if ($RefreshUrl) {
        try {
            $Bundle = (Invoke-WebRequest -Uri $RefreshUrl -TimeoutSec 10 -UseBasicParsing).Content | ConvertFrom-Json
            if ($Bundle.heartbeat_put_url)  { $Bundle.heartbeat_put_url  | Set-Content -Path $UrlFile -Encoding UTF8 }
            if ($Bundle.scan_put_url)       { $Bundle.scan_put_url       | Set-Content -Path (Join-Path $AgentDir "scan_url.txt") -Encoding UTF8 }
            if ($Bundle.authorized_get_url) { $Bundle.authorized_get_url | Set-Content -Path (Join-Path $AgentDir "authorized_url.txt") -Encoding UTF8 }
        } catch {
            # urls_refresh_url.txt is itself a presigned URL with the same
            # 7-day TTL and nothing re-pushes a fresh one to this laptop —
            # the 2026-06 fleet heartbeat outage RCA. Fall back to the
            # server's token-authenticated refresh endpoint (no API key).
            try {
                $ServerUrl = "https://patronai.giggso.com/agent/url-refresh/$($Cfg.token)"
                $Bundle = (Invoke-WebRequest -Uri $ServerUrl -TimeoutSec 10 -UseBasicParsing).Content | ConvertFrom-Json
                if ($Bundle.heartbeat_put_url)  { $Bundle.heartbeat_put_url  | Set-Content -Path $UrlFile -Encoding UTF8 }
                if ($Bundle.scan_put_url)       { $Bundle.scan_put_url       | Set-Content -Path (Join-Path $AgentDir "scan_url.txt") -Encoding UTF8 }
                if ($Bundle.authorized_get_url) { $Bundle.authorized_get_url | Set-Content -Path (Join-Path $AgentDir "authorized_url.txt") -Encoding UTF8 }
            } catch { <# best-effort — retried next cycle #> }
        }
    }
}

# 2. Build identity-rich payload.
if (-not (Test-Path $UrlFile)) { exit 0 }
$HbUrl = (Get-Content $UrlFile).Trim()
if (-not $HbUrl) { exit 0 }
try {
    $Ips = @(Get-NetIPAddress -AddressFamily IPv4 -ErrorAction SilentlyContinue |
             Where-Object { $_.IPAddress -notlike "127.*" -and $_.IPAddress -notlike "169.254.*" } |
             Select-Object -ExpandProperty IPAddress -Unique)
} catch { $Ips = @() }
$Payload = @{
    event_type   = "HEARTBEAT"
    status       = "installed"
    device_id    = $env:COMPUTERNAME
    device_uuid  = $Cfg.device_uuid
    mac_primary  = $Cfg.mac_primary
    ip_set       = $Ips
    email        = $Cfg.email
    token        = $Cfg.token
    company      = $Cfg.company
    os_name      = "Windows"
    os_version   = (Get-CimInstance Win32_OperatingSystem).Version
    agent_version= "2.0.0"
    timestamp    = (Get-Date -Format "yyyy-MM-ddTHH:mm:ssZ")
} | ConvertTo-Json -Compress

# 3. PUT, capture HTTP status, append structured log line.
$HttpStatus = 0
try {
    $Resp = Invoke-WebRequest -Uri $HbUrl -Method Put -Body $Payload `
        -ContentType "application/json" -TimeoutSec 30 -UseBasicParsing
    $HttpStatus = [int]$Resp.StatusCode
} catch {
    if ($_.Exception.Response) { $HttpStatus = [int]$_.Exception.Response.StatusCode }
}
$Ts = (Get-Date -Format "yyyy-MM-ddTHH:mm:ssZ")
"{`"ts`":`"$Ts`",`"type`":`"heartbeat`",`"http_status`":$HttpStatus}" | Add-Content -Path $Log

# Step 0.1 — hook coverage backstop. Walk every .git under USERPROFILE
# and ensure the chain-installed pre-commit hook is in place. The
# chain library (hook_chain.ps1) is idempotent: pre-existing Raven /
# husky / user hooks are preserved as pre-commit.pre-patronai and
# called from our chain shim, never overwritten.
$HookScript = Join-Path $AgentDir "pre_commit_hook.ps1"
$ChainLib   = Join-Path $AgentDir "hook_chain.ps1"
if ((Test-Path $HookScript) -and (Test-Path $ChainLib)) {
    . $ChainLib
    $Added  = 0
    $Marker = "PatronAI managed pre-commit chain"
    Get-ChildItem -Path $env:USERPROFILE -Recurse -Depth 4 -Filter ".git" -Directory -ErrorAction SilentlyContinue | ForEach-Object {
        $HD = Join-Path $_.FullName "hooks"
        $HP = Join-Path $HD "pre-commit"
        # Skip the common case (chain already present) without paying
        # the cost of a rewrite; otherwise defer to the library.
        if ((Test-Path $HP) -and ((Get-Content $HP -Raw -ErrorAction SilentlyContinue) -match $Marker)) {
            return
        }
        if (Install-PatronAIChainHook -HooksDir $HD) { $Added++ }
    }
    if ($Added -gt 0) {
        "{`"ts`":`"$Ts`",`"type`":`"hook_backstop`",`"added`":$Added}" | Add-Content -Path $Log
    }
}

# Step 0.2 - Packetbeat watchdog. Task Scheduler's own execution-time-limit
# and restart settings for a long-running process are real but not fully
# reliable (community reports of -ExecutionTimeLimit 0 not truly meaning
# "unlimited" - see setup notes), so this heartbeat-driven check is the
# actual resilience mechanism: if the marker from install time is present
# and the real process isn't, re-trigger the scheduled task. Runs every 5
# minutes alongside everything else here - no separate schedule needed.
$PbFlag = Join-Path $AgentDir "packetbeat_enabled.flag"
if (Test-Path $PbFlag) {
    if (-not (Get-Process -Name "packetbeat" -ErrorAction SilentlyContinue)) {
        try {
            Start-ScheduledTask -TaskName "PatronAI-Packetbeat" -ErrorAction SilentlyContinue
            "{`"ts`":`"$Ts`",`"type`":`"packetbeat_watchdog_restart`"}" | Add-Content -Path $Log
        } catch { <# best-effort - retried next cycle #> }
    }
}
'@ | Set-Content -Path $HeartbeatScript -Encoding UTF8

# ── Hidden-launch shim ────────────────────────────────────────
# Task Scheduler invoking powershell.exe directly still briefly flashes a
# console window on many Windows builds even with -WindowStyle Hidden — the
# OS allocates a console host before PowerShell's own startup code can apply
# that style. WScript.Shell.Run with windowStyle=0 suppresses the window at
# process-creation time instead, so nothing ever flashes on screen. Every 5
# minutes was visibly popping a window; this is the fix.
# ACCEPTED RISK (PR#10 review, N1): a wscript.exe + WScript.Shell.Run hidden
# launcher is a pattern AV/EDR heuristics sometimes flag, since it's also a
# known living-off-the-land technique — ironic for a security product. If
# quarantined, the Scheduled Tasks silently stop firing with no error in the
# install log. Accepted for now over the added infra of a compiled/signed
# launcher; add an AV-exclusion note to the install runbook if this bites.
$HiddenLauncher = Join-Path $AgentDir "run_hidden.vbs"
@'
Dim shell, cmd
Set shell = CreateObject("WScript.Shell")
cmd = "powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File " & Chr(34) & WScript.Arguments(0) & Chr(34)
shell.Run cmd, 0, False
'@ | Set-Content -Path $HiddenLauncher -Encoding ASCII

# ── Register Task Scheduler tasks ────────────────────────────
function Register-PatronAITask($TaskName, $ScriptPath, $IntervalMinutes, $Desc) {
    $Action   = New-ScheduledTaskAction -Execute "wscript.exe" `
        -Argument "//B `"$HiddenLauncher`" `"$ScriptPath`""
    $Trigger  = New-ScheduledTaskTrigger -RepetitionInterval (New-TimeSpan -Minutes $IntervalMinutes) `
        -Once -At (Get-Date)
    $Settings = New-ScheduledTaskSettingsSet -ExecutionTimeLimit (New-TimeSpan -Minutes 2) `
        -StartWhenAvailable -DontStopIfGoingOnBatteries -RunOnlyIfNetworkAvailable -Hidden
    try {
        Unregister-ScheduledTask -TaskName $TaskName -Confirm:$false -ErrorAction SilentlyContinue
        Register-ScheduledTask -TaskName $TaskName -Action $Action -Trigger $Trigger `
            -Settings $Settings -Description $Desc -RunLevel Limited | Out-Null
        Write-Info "$TaskName registered (every $IntervalMinutes min)."
    } catch {
        Write-Info "$TaskName registration failed: $_"
    }
}

Register-PatronAITask "PatronAI-Heartbeat" $HeartbeatScript 5  "PatronAI liveness heartbeat"
Register-PatronAITask "PatronAI-Scan"      $ScanScript      30 "PatronAI endpoint scan (packages/processes/browser)"

# Run first scan immediately in background
Start-Process wscript.exe -ArgumentList "//B `"$HiddenLauncher`" `"$ScanScript`""

Remove-Item -Path $TmpMeta -ErrorAction SilentlyContinue

# ── Optional: network-target visibility (Packetbeat + Npcap) ─────────
# Opt-in only (PATRONAI_ENABLE_PACKETBEAT=1) and never fatal to the main
# install - this whole block is wrapped so a failure here can't trip the
# script's global $ErrorActionPreference="Stop" and abort a working agent
# install over an optional module.
#
# Confirmed this session against a real Packetbeat 9.5.2 install: real TLS
# SNI capture works and correctly identifies a real destination hostname.
#
# v2 (2026-08-31): stopped manually downloading/installing free Npcap.
#   - The free Npcap edition's license caps use at 5 machines unless used
#     only with Nmap/Wireshark/Defender for Identity - deploying it
#     ourselves across a fleet is a license violation, not just an
#     inconvenience (confirmed: npcap.com license terms).
#   - Packetbeat's own official download bundles a licensed Npcap OEM
#     copy and installs/upgrades it itself on first run (confirmed:
#     elastic/beats#34420, Elastic's own integration docs). That silent,
#     license-compliant install is Elastic's, not something we script.
#
# v3 (2026-08-31): dropped install-service-packetbeat.ps1 (native Windows
# Service) entirely, after REAL testing disproved the v2 hang theory -
# Packetbeat still failed to reach Running on the very first start even
# with Npcap already installed and idle beforehand, ruling out an
# Npcap-install-collision as the cause. The real, still-open upstream bug
# (elastic/beats#34272, related Go/Windows-service issue golang/go#23479
# referenced in elastic/beats#8711) is that Go binaries running as native
# Windows services can fail to report SERVICE_RUNNING to the SCM within
# its 30s window. Our own macOS/Linux installer already avoids native
# systemd services for this exact class of problem (nohup + @reboot cron
# instead), and this file already does the same for Heartbeat/Scan (Task
# Scheduler, not a Windows Service) - so Packetbeat now uses that same,
# already-proven mechanism instead of the SCM start protocol that's
# hitting the bug. CONFIRMED against a real machine this session:
# Packetbeat reached Running via Task Scheduler on first start - the
# thing it could never do as a native service in any earlier test.
#
# v3.1 (2026-08-31): dropped the "start once, then flip
# npcap.never_install and restart" two-phase dance. It caused a real,
# reproduced failure (task ran, LastTaskResult=1, process not running
# after the restart) that first-start alone never hit. Since Npcap's own
# presence is checkable up front, there's no need to start Packetbeat
# twice to find out - decide never_install before the only start attempt
# instead.
$PacketbeatActive = $false
if ($env:PATRONAI_ENABLE_PACKETBEAT -eq "1") {
    $IsAdmin = ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
    $PbTaskName = "PatronAI-Packetbeat"
    if (-not $IsAdmin) {
        Write-Info "PATRONAI_ENABLE_PACKETBEAT=1 but this session is not elevated - skipping network-target capture (Npcap's driver install requires Administrator). Re-run as Administrator to enable it."
    } elseif ((Get-Process -Name "packetbeat" -ErrorAction SilentlyContinue)) {
        # Re-run of this installer (config refresh, repeat OTP flow, etc.) -
        # Packetbeat is already installed and running from a prior pass.
        # Skip re-downloading/re-installing entirely.
        Write-Info "Packetbeat already running - skipping re-install."
        $PacketbeatActive = $true
    } else {
        try {
            Write-Info "Installing Packetbeat (bundles and silently installs its own licensed Npcap - no separate Npcap download needed)..."
            $PbZip = Join-Path $env:TEMP "packetbeat.zip"
            # Invoke-WebRequest's default progress-bar rendering has a real,
            # well-documented per-chunk overhead in Windows PowerShell that
            # can throttle large downloads enough to trigger a transport-
            # level "unexpected EOF" failure (confirmed against a real
            # ~36MB download this session). Suppressing it for just this
            # download is the documented fix - restored right after.
            $PrevProgressPreference = $ProgressPreference
            $ProgressPreference = 'SilentlyContinue'
            try {
                Invoke-WebRequest -Uri "https://artifacts.elastic.co/downloads/beats/packetbeat/packetbeat-9.5.2-windows-x86_64.zip" -OutFile $PbZip -TimeoutSec 180
            } finally {
                $ProgressPreference = $PrevProgressPreference
            }
            $PbRoot = "C:\Packetbeat"
            Expand-Archive -Path $PbZip -DestinationPath $PbRoot -Force
            $PbHome   = Join-Path $PbRoot "packetbeat-9.5.2-windows-x86_64"
            $PbConfig = Join-Path $PbHome "packetbeat.yml"

            # Default config points at a local Elasticsearch that (almost always)
            # doesn't exist. Point output at a local NDJSON file inside AgentDir
            # instead - the scan pipeline reading/forwarding this file is a
            # separate, not-yet-built consumer; this step only lands the raw
            # capture safely, it does not claim to wire it into findings yet.
            (Get-Content $PbConfig) -replace '(?m)^output\.elasticsearch:', '#output.elasticsearch:' |
                Set-Content $PbConfig
            Add-Content $PbConfig "`noutput.file:`n  path: `"$AgentDir`"`n  filename: packetbeat_capture`n  rotate_every_kb: 10000`n  number_of_files: 3`n"

            # Decide npcap.never_install BEFORE the only start attempt (see
            # v3.1 note above) - if Npcap is already confirmed present, skip
            # Packetbeat's own startup-time install/verify check entirely;
            # otherwise leave it unset so Packetbeat's bundled installer
            # gets its one chance to provision Npcap on this first run.
            if ((Get-Service npcap -ErrorAction SilentlyContinue).Status -eq "Running") {
                Add-Content $PbConfig "`npacketbeat.npcap.never_install: true`n"
            }

            # Task Scheduler, not a native Windows Service - see v3 note
            # above. Runs as SYSTEM so it survives reboot without a logged-
            # on user and has the privileges Npcap needs. ExecutionTimeLimit
            # is set generously long rather than to zero/"unlimited" -
            # community reports say ExecutionTimeLimit=0 doesn't reliably
            # mean unlimited in practice, so an explicit long value is the
            # safer, unambiguous choice. Real long-term resilience comes
            # from the heartbeat watchdog (heartbeat.ps1, Step 0.2 below),
            # not from Task Scheduler's own restart semantics alone.
            $PbAction    = New-ScheduledTaskAction -Execute (Join-Path $PbHome "packetbeat.exe") `
                -Argument "-e -c `"$PbConfig`"" -WorkingDirectory $PbHome
            $PbTrigger   = New-ScheduledTaskTrigger -AtStartup
            $PbSettings  = New-ScheduledTaskSettingsSet -ExecutionTimeLimit (New-TimeSpan -Days 3650) `
                -RestartCount 3 -RestartInterval (New-TimeSpan -Minutes 1) `
                -StartWhenAvailable -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries
            $PbPrincipal = New-ScheduledTaskPrincipal -UserId "SYSTEM" -LogonType ServiceAccount -RunLevel Highest
            Unregister-ScheduledTask -TaskName $PbTaskName -Confirm:$false -ErrorAction SilentlyContinue
            Register-ScheduledTask -TaskName $PbTaskName -Action $PbAction -Trigger $PbTrigger `
                -Settings $PbSettings -Principal $PbPrincipal -Description "PatronAI Packetbeat network-target capture" | Out-Null
            Start-ScheduledTask -TaskName $PbTaskName
            Start-Sleep -Seconds 5   # first start may also be installing Packetbeat's bundled Npcap - give it a bit longer

            if ((Get-Process -Name "packetbeat" -ErrorAction SilentlyContinue)) {
                Write-Info "Packetbeat running via Task Scheduler - network-target capture enabled (writing to $AgentDir\packetbeat_capture*.ndjson)."
                New-Item -ItemType File -Force -Path (Join-Path $AgentDir "packetbeat_enabled.flag") | Out-Null
                $PacketbeatActive = $true
            } else {
                Write-Info "WARNING: Packetbeat did not start via Task Scheduler - deeper investigation needed. Network-target capture is NOT active on this machine; this does not block the rest of the install."
            }
        } catch {
            Write-Info "WARNING: Packetbeat install failed ($_) - continuing without network-target capture. This is a non-fatal, optional module."
        }
    }
}

# Second status update - the first one (above, well before this block)
# fires as soon as the core install succeeds and can't yet know the
# final Packetbeat outcome. This lets IT see at a glance, per device,
# whether deep network-target visibility actually ended up active -
# never assumed true just because the flag was requested.
$PacketbeatStatusPayload = @{
    token             = $Token
    status            = "installed"
    device_id         = $env:COMPUTERNAME
    installed_at      = (Get-Date -Format "yyyy-MM-ddTHH:mm:ssZ")
    packetbeat_active = $PacketbeatActive
} | ConvertTo-Json -Compress
try {
    Invoke-WebRequest -Uri $StatusPutUrl -Method Put -Body $PacketbeatStatusPayload `
        -ContentType "application/json" -TimeoutSec 15 | Out-Null
} catch { <# non-fatal #> }

# ── Drop the recipient-side diagnose script ──────────────────
$Diag = Join-Path $AgentDir "diagnose.ps1"
@'
{{INLINE_DIAGNOSE_PS1}}
'@ | Set-Content -Path $Diag -Encoding UTF8

Write-Host ""
Write-Info "Installation complete."
Write-Info "Pre-commit hook installed in $InstallCount existing repositories."
Write-Info "New repos auto-instrumented via init.templateDir — no manual step needed."
Write-Info "Endpoint scan every 30 min — packages, processes, browsers, IDE plugins, containers, shell history,"
Write-Info "                              MCP servers, agent workflows, scheduled agents, tool registrations, vector DBs."
Write-Info "First scan runs in baseline mode (wider walk); subsequent scans run lighter."
Write-Info "Heartbeat every 5 min — refreshes presigned URLs AND auto-installs the pre-commit hook"
Write-Info "                       in any new git repo cloned/init-ed since the last cycle."
Write-Info "AI framework signals in git commits will be forwarded for analysis."
Write-Info "If anything looks off later, run:  powershell -File ~/.patronai/diagnose.ps1"
