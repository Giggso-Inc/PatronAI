# =============================================================
# PatronAI — Agent Installer (Windows PowerShell)
# Generated for: {{RECIPIENT_NAME}} <{{RECIPIENT_EMAIL}}>
# Token: {{TOKEN}}
# Expires: {{EXPIRES_AT}}
#
# USAGE: powershell -ExecutionPolicy Bypass -File setup_agent.ps1
# REQUIRES: PowerShell 5.1+, Python 3 (with bcrypt installed)
#
# NOTE ON NON-ASCII CHARACTERS: this raw template file has no UTF-8 BOM
# (source-controlled text). Windows PowerShell 5.1 falls back to the system
# ANSI codepage when reading a script with no BOM, which can misread a
# multi-byte UTF-8 character (e.g. an em-dash) inside a double-quoted string
# and corrupt the rest of the parse - confirmed live against this exact file
# with [System.Management.Automation.Language.Parser]::ParseFile(). The
# actual SHIPPED installer is unaffected: render_agent_package.py re-encodes
# the rendered output as utf-8-sig (BOM) before upload specifically because
# of this issue (see that file's v1.6.1 changelog). Comments are free to use
# em-dashes/curly quotes/etc. (the parser ignores comment content either
# way) - but any string literal actually reachable by PowerShell's tokenizer
# (Write-Host/Write-Info calls, variable values) MUST stay plain ASCII here,
# so this template is also correctly parseable on its own without depending
# on that downstream BOM re-encoding step.
# =============================================================
$ErrorActionPreference = "Stop"

# >>> RavenInstallCommon (inlined by tools/inline_install_common.py -- do not edit by hand, edit the .psm1 source) >>>
# ==============================================================================
# RavenInstallCommon -- shared preflight/runtime helpers for every Windows
# installer entry point (Raven agent, Raven org-invite template, Raven
# add-on template, CoworkDLP, PatronAI agent template).
#
# Phase 1 of the installer-architecture proposal (2026-11-17): these
# functions already existed, duplicated and drifting, across 5 separate
# files. This module is the single copy; each entry point now imports it
# instead of carrying its own version. ZERO behavior change versus the
# best existing version of each function -- the VC++ detection below is
# copied verbatim from hub/templates/raven_install.ps1.template (PR #657),
# not reimplemented.
#
# Import from any entry point with:
#   Import-Module (Join-Path $PSScriptRoot "RavenInstallCommon.psm1") -Force
#
# This module must be imported, and Assert-RavenRelaunched64Bit called,
# BEFORE any installer-specific logic runs (OTP collection, self-enroll,
# feature installs). It changes nothing about what happens after that --
# it only guarantees WHICH PowerShell host runs it.
# ==============================================================================

$ErrorActionPreference = "Stop"

# ------------------------------------------------------------------------
# Change 2 -- Runtime pin: relaunch as 64-bit PowerShell before anything
# else runs, instead of detecting-and-working-around 32-bit/WOW64 issues
# at each individual call site.
#
# [2026-11-17] Root cause this closes: raven_install.ps1.template's own
# comment admits it relaunches NOTHING -- only install-windows.ps1 (the
# agent step) self-relaunches. The template's VC++ check was fixed to read
# correctly THROUGH Sysnative under 32-bit PowerShell (PR #657), but
# every other 32-bit-sensitive read in that same file ($env:ProgramFiles,
# $env:PROCESSOR_ARCHITECTURE) was never fixed, because the script never
# stops being 32-bit in the first place. This function removes the cause
# instead of adding a third individually-patched call site.
#
# Safe to call from a script that is ALREADY 64-bit: Is64BitProcess is
# true, the condition below is false, and the function returns immediately
# with no relaunch, no extra process, no behavior change.
# ------------------------------------------------------------------------
function Assert-RavenRelaunched64Bit {
    param(
        # Pass $PSCommandPath from the CALLING script -- this module has no
        # reliable path of its own once imported/inlined, and relaunching
        # the wrong file would be worse than not relaunching at all.
        #
        # [2026-11-17] NOT Mandatory, and deliberately typed to allow an
        # empty string -- found by actually RUNNING this function (not just
        # syntax-checking it): $PSCommandPath is empty in some invocation
        # contexts (e.g. pasted into an interactive session rather than run
        # as a real .ps1 file), and a Mandatory parameter rejects an empty
        # string at BIND time, before the function body's own
        # "-and $ScriptPath" fallback check ever gets a chance to run. The
        # real shipped installers always run as a real file
        # (powershell -File ...), where $PSCommandPath is always populated
        # -- this only matters for robustness in atypical invocations.
        [AllowEmptyString()][string]$ScriptPath = "",
        [string[]]$ScriptArgs = @()
    )

    # Matches the proven pattern already shipping in
    # hub/app/assets/addon_scripts/windows.ps1 (2026-11-12) exactly,
    # including the env-var relaunch guard -- that script's own comment
    # notes this is the SAME architecture-normalization problem as
    # raven_install.ps1.template, just fixed correctly in this one place
    # first. Extracted here so both (and every other entry point) share
    # one copy instead of three independently-drifting ones.
    #
    # The guard (RAVEN_ORG_ARCH_RELAUNCHED) is defensive: Is64BitProcess
    # should always be true immediately after a real relaunch, so the
    # condition below is false on the second pass regardless -- but an
    # environment-variable belt-and-braces costs nothing and this is
    # exactly the kind of check a stale/weird PowerShell host is the type
    # to get wrong in a way nobody has seen yet.
    if ([Environment]::Is64BitOperatingSystem -and -not [Environment]::Is64BitProcess `
            -and -not $env:RAVEN_ORG_ARCH_RELAUNCHED -and $ScriptPath) {
        $sysNativePwsh = Join-Path $env:WINDIR "sysnative\WindowsPowerShell\v1.0\powershell.exe"
        if (Test-Path $sysNativePwsh) {
            Write-Host "  32-bit PowerShell on 64-bit Windows -- restarting this installer in 64-bit PowerShell..." -ForegroundColor DarkCyan
            $env:RAVEN_ORG_ARCH_RELAUNCHED = "1"
            & $sysNativePwsh -NoProfile -ExecutionPolicy Bypass -File $ScriptPath @ScriptArgs
            exit $LASTEXITCODE
        }
        Write-Host "  32-bit PowerShell on 64-bit Windows and sysnative is unavailable -- using architecture-aware fallbacks." -ForegroundColor DarkYellow
    }
}

# ------------------------------------------------------------------------
# VC++ runtime detection -- copied verbatim from
# hub/templates/raven_install.ps1.template (PR #657). Do not re-derive;
# this exact version already fixed two real, confirmed bugs (WOW64
# redirection via Sysnative, and false negatives from gating on
# vcruntime140*.dll which CPython vendors itself). CoworkDLP's
# check_prerequisites.ps1 still has the OLD, disproven 3-DLL/System32
# version -- importing this module into that file is exactly what fixes it.
# ------------------------------------------------------------------------
function Get-VCRedistState {
    $sysDir = Join-Path $env:SystemRoot "System32"
    if (-not [Environment]::Is64BitProcess -and [Environment]::Is64BitOperatingSystem) {
        $sysDir = Join-Path $env:SystemRoot "Sysnative"
    }

    $regVersion = $null
    $regInstalled = $false
    try {
        $hklm = [Microsoft.Win32.RegistryKey]::OpenBaseKey(
            [Microsoft.Win32.RegistryHive]::LocalMachine,
            [Microsoft.Win32.RegistryView]::Registry64)
        $key = $hklm.OpenSubKey("SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64")
        if ($key) {
            $regInstalled = ([int]$key.GetValue("Installed", 0) -eq 1)
            $regVersion = [string]$key.GetValue("Version", "")
            $key.Close()
        }
        $hklm.Close()
    } catch { }

    [pscustomobject]@{
        SystemDir  = $sysDir
        Msvcp140   = Test-Path (Join-Path $sysDir "msvcp140.dll")
        RegInstall = $regInstalled
        RegVersion = $regVersion
    }
}

function Test-VCRedistPresent {
    $st = Get-VCRedistState
    return [bool]$st.Msvcp140
}

# ------------------------------------------------------------------------
# Web calls -- every outbound request wrapped with -UseBasicParsing by
# construction, so the IE-engine ShouldContinue prompt (interactive,
# defaults to declining) and the NonInteractive-mode throw (scheduled
# tasks) become structurally impossible here, instead of relying on every
# call site remembering the switch by hand -- the exact omission PatronAI
# fixed 4 times over in PR #88.
# ------------------------------------------------------------------------
function Invoke-RavenWebRequest {
    param(
        [Parameter(Mandatory = $true)][string]$Uri,
        [string]$Method = "GET",
        [string]$Body = $null,
        [hashtable]$Headers = @{},
        [int]$TimeoutSec = 30,
        [string]$OutFile = $null
    )
    $params = @{
        Uri             = $Uri
        Method          = $Method
        Headers         = $Headers
        TimeoutSec      = $TimeoutSec
        UseBasicParsing = $true
    }
    if ($Body) { $params["Body"] = $Body; $params["ContentType"] = "application/json" }
    if ($OutFile) { $params["OutFile"] = $OutFile }
    return Invoke-WebRequest @params
}

# ------------------------------------------------------------------------
# BOM-less UTF-8 file writes -- Set-Content -Encoding utf8 on PowerShell
# 5.1 emits a UTF-8 BOM, which every Python reader of a generated config
# (sync.py, slm_onnx.py, guardrail_classifier.py in CoworkDLP) fails to
# parse with JSONDecodeError. WriteAllText with an explicit BOM-less
# encoding matches what every consumer actually expects.
# ------------------------------------------------------------------------
function Write-RavenFileNoBom {
    param(
        [Parameter(Mandatory = $true)][string]$Path,
        [Parameter(Mandatory = $true)][string]$Content
    )
    [System.IO.File]::WriteAllText($Path, $Content, (New-Object System.Text.UTF8Encoding $false))
}

# ------------------------------------------------------------------------
# Start-Process wrapper that always captures -PassThru and returns a real
# exit code -- the exact mechanism the WOW64 incident's own postmortem
# named as the reason the real failure produced no diagnostic at all.
#
# -Wait is OPTIONAL, not defaulted to $true, because at least one real
# caller needs fire-and-forget launch semantics (PatronAI's background
# first-scan trigger) -- defaulting it here would silently turn that into
# a blocking call. Caller contract: if -Wait is omitted, the returned
# process object's .ExitCode is NOT meaningful (the process has not
# necessarily terminated yet) -- it still proves the launch itself
# succeeded (PassThru always set), which is the signal fire-and-forget
# callers actually want. Callers that need the real exit code MUST pass
# -Wait.
# ------------------------------------------------------------------------
function Start-RavenProcess {
    param(
        [Parameter(Mandatory = $true)][string]$FilePath,
        [string[]]$ArgumentList = @(),
        [switch]$Wait,
        [switch]$NoNewWindow
    )
    $params = @{ FilePath = $FilePath; ArgumentList = $ArgumentList; PassThru = $true }
    if ($Wait) { $params["Wait"] = $true }
    if ($NoNewWindow) { $params["NoNewWindow"] = $true }
    $proc = Start-Process @params
    return $proc  # caller reads $proc.ExitCode -- never silently discarded.
}

# <<< RavenInstallCommon (inlined) <<<

# [2026-11-17, Phase 1 of the installer-architecture proposal] PatronAI has
# no VC++ dependency (no native Python deps like Cowork's torch/spaCy), so
# the WOW64 hazard here is narrower than Raven/CoworkDLP's -- but a 32-bit
# PowerShell host still reads $env:ProgramFiles / PROCESSOR_ARCHITECTURE
# wrong for Python discovery (see setup_agent's own winget-based Python
# auto-install below), so the same relaunch is applied for consistency and
# to close that class before it's ever hit here. This template ships as a
# single standalone file -- no sibling files on the user's machine -- so
# the shared module is INLINED at build time, not imported at runtime; see
# raven-enterprise's tools/inline_install_common.py (same build step,
# pointed at this repo's copy of RavenInstallCommon.psm1).
Assert-RavenRelaunched64Bit -ScriptPath $PSCommandPath -ScriptArgs $args

$MetaUrl           = "{{META_URL}}"
$StatusPutUrl      = "{{STATUS_PUT_URL}}"
$HeartbeatPutUrl   = "{{HEARTBEAT_PUT_URL}}"
$ScanPutUrl        = "{{SCAN_PUT_URL}}"
$AuthorizedGetUrl  = "{{AUTHORIZED_GET_URL}}"
$UrlsRefreshUrl    = "{{URLS_REFRESH_URL}}"
$AuthorizedDomains = "{{AUTHORIZED_DOMAINS}}"
$Bucket            = "{{BUCKET}}"
$Region            = "{{REGION}}"
$Company           = "{{COMPANY}}"
$Token             = "{{TOKEN}}"
$RecipientName     = "{{RECIPIENT_NAME}}"
$RecipientEmail    = "{{RECIPIENT_EMAIL}}"
$AgentVersion      = "{{AGENT_VERSION}}"

$AgentDir   = Join-Path $env:USERPROFILE ".patronai"
$ConfigPath = Join-Path $AgentDir "config.json"

function Write-Info($msg) { Write-Host "[patronai] $msg" }
function Write-Fail($msg) { Write-Host "ERROR: $msg" -ForegroundColor Red; exit 1 }

# ── Prerequisites, checked all at once up front ───────────────
# Same rationale as setup_agent.sh's equivalent block: failing here is
# instant, versus discovering a missing dependency mid-install (e.g. git at
# the init.templateDir step, well after config.json/identity are already
# written) and leaving a half-installed agent behind.
if ($PSVersionTable.PSVersion -lt [version]"5.1") {
    Write-Fail "PowerShell 5.1 or newer is required (found $($PSVersionTable.PSVersion))."
}
if (-not (Get-Command git -ErrorAction SilentlyContinue)) {
    Write-Fail "git is required (the pre-commit hook is installed via 'git config init.templateDir'). Install from https://git-scm.com/downloads and re-run."
}

# ── Validate / auto-install python3, then bcrypt ──────────────
function Test-PythonAvailable {
    # Checks the actual output looks like a real interpreter, not just that
    # the call didn't throw - a machine with no real Python installed but
    # the Windows Store "python.exe" app-execution-alias stub on PATH can
    # return exit code 0 with no real version string, which a bare
    # try/catch around `python --version` would misread as "available".
    try {
        $versionOutput = (python --version 2>&1 | Out-String).Trim()
        return ($LASTEXITCODE -eq 0 -and $versionOutput -match '^Python \d+\.\d+\.\d+')
    } catch {
        return $false
    }
}

if (-not (Test-PythonAvailable)) {
    if (Get-Command winget -ErrorAction SilentlyContinue) {
        Write-Info "Python not found - installing via winget..."
        try {
            winget install --id Python.Python.3.12 -e --silent --accept-package-agreements --accept-source-agreements | Out-Null
        } catch {
            Write-Fail "Python 3 is required and 'winget install' could not be launched ($_). Install manually from python.org and re-run."
        }
        # PowerShell does not turn a non-zero exit from a native command
        # like winget.exe into a terminating error the try/catch above
        # would see - it only sets $LASTEXITCODE. Without checking it
        # explicitly, a real winget failure (package not found, needs
        # elevation, no network, unaccepted agreement) would silently fall
        # through to the PATH re-check below and get reported there with a
        # misleading "winget reported success" message.
        if ($LASTEXITCODE -ne 0) {
            Write-Fail "Python 3 is required and 'winget install' failed (exit code $LASTEXITCODE). Install manually from python.org and re-run."
        }
        # winget updates the machine/user PATH, but this already-running
        # PowerShell process does not see that change until it is re-read
        # from the registry - without this, the check below would still
        # fail even right after a successful winget install.
        $env:Path = [System.Environment]::GetEnvironmentVariable("Path", "Machine") + ";" +
                    [System.Environment]::GetEnvironmentVariable("Path", "User")
        if (-not (Test-PythonAvailable)) {
            Write-Fail "Python 3 is required. winget install succeeded but 'python' is still not resolving to a real interpreter on PATH - install manually from python.org, restart your terminal, and re-run."
        }
        Write-Info "Python installed successfully."
    } else {
        Write-Fail "Python 3 is required and winget is not available on this machine. Install manually from python.org and re-run."
    }
}
$bcryptOk = python -c "import bcrypt; print('ok')" 2>$null
if ($bcryptOk -ne "ok") {
    Write-Info "Installing bcrypt..."
    pip install --quiet "bcrypt>=4.0.0" | Out-Null
}

# ── Prompt for OTP (accepts non-interactive OTP via env var) ─
# Standalone installs prompt, exactly as before. When invoked by
# Raven's installer, $env:PATRONAI_OTP is the SAME 6-digit code the
# user typed into Raven; Raven Hub has already mirrored that code
# into this package's meta.json bcrypt hash (via /agent/provision
# otp_override), so the same validation below still runs — no trust
# flag, no bypass. Attacker with only the .ps1 cannot install.
Write-Host ""
Write-Host "PatronAI Agent Installer"
Write-Host "========================"
Write-Host "Recipient : $RecipientName"
Write-Host "Company   : $Company"
Write-Host ""

if ($env:PATRONAI_OTP) {
    $OtpInput = $env:PATRONAI_OTP
    Write-Info "Using OTP passed by caller (non-interactive)."
} else {
    $OtpInput = Read-Host "Enter your 6-digit installation OTP"
}

if ($OtpInput -notmatch '^\d{6}$') {
    Write-Fail "OTP must be exactly 6 digits."
}

# ── Download and validate meta ────────────────────────────────
Write-Info "Validating OTP..."
$TmpMeta = Join-Path $env:TEMP "patronai-meta-$Token.json"
try {
    Invoke-WebRequest -Uri $MetaUrl -OutFile $TmpMeta -TimeoutSec 30 -UseBasicParsing
} catch {
    Write-Fail "Cannot reach installation server. URL may have expired."
}

$OtpHash = python -c "import json; print(json.load(open(r'$TmpMeta'))['otp_hash'])"
$Expires  = python -c "import json; print(json.load(open(r'$TmpMeta'))['expires_at'])"

$Expired = python -c @"
from datetime import datetime, timezone
e = datetime.fromisoformat('$Expires')
print('yes' if datetime.now(timezone.utc) > e else 'no')
"@
if ($Expired -eq "yes") { Write-Fail "Installation package has expired. Request a new one." }

$Valid = python -c @"
import bcrypt
try:
    ok = bcrypt.checkpw(b'$OtpInput', b'$OtpHash')
    print('yes' if ok else 'no')
except Exception:
    print('no')
"@
if ($Valid -ne "yes") { Write-Fail "Invalid OTP. Please check your email and try again." }
Write-Info "OTP validated."

# ── Install agent files (identity baked at install) ──────────
New-Item -ItemType Directory -Force -Path $AgentDir | Out-Null

# Compute MAC + device_uuid once, then persist alongside token/email.
# Get-NetAdapter has no built-in timeout and is known to hang on some
# machines (WMI provider issues, VPN/virtual adapters) - bounded via a
# background job so a slow/stuck WMI call can never block the whole
# install. Falls back to the zero MAC (same as the "not found" case)
# rather than hanging indefinitely if it doesn't return in time.
$DeviceUuid  = [guid]::NewGuid().ToString()
$MacPrimary  = $null
try {
    $macJob = Start-Job -ScriptBlock {
        (Get-NetAdapter | Where-Object Status -eq "Up" | Select-Object -First 1 -ExpandProperty MacAddress)
    }
    if (Wait-Job $macJob -Timeout 10) {
        $MacPrimary = (Receive-Job $macJob) -replace "-", ":"
    } else {
        Write-Info "MAC address lookup timed out after 10s - continuing without it."
    }
    Remove-Job $macJob -Force -ErrorAction SilentlyContinue
} catch { }
if (-not $MacPrimary) { $MacPrimary = "00:00:00:00:00:00" }

$Config = @{
    bucket      = $Bucket
    region      = $Region
    company     = $Company
    token       = $Token
    email       = $RecipientEmail
    device_uuid = $DeviceUuid
    mac_primary = $MacPrimary.ToLower()
    agent_dir   = $AgentDir
} | ConvertTo-Json
$Config | Set-Content -Path $ConfigPath -Encoding UTF8

# Persist presigned URLs + URL-refresh endpoint + authorised list fallback.
$HeartbeatPutUrl   | Set-Content -Path (Join-Path $AgentDir "heartbeat_url.txt")      -Encoding UTF8
$ScanPutUrl        | Set-Content -Path (Join-Path $AgentDir "scan_url.txt")            -Encoding UTF8
$AuthorizedGetUrl  | Set-Content -Path (Join-Path $AgentDir "authorized_url.txt")      -Encoding UTF8
$UrlsRefreshUrl    | Set-Content -Path (Join-Path $AgentDir "urls_refresh_url.txt")    -Encoding UTF8

# agent_version.txt — read by heartbeat.ps1 at runtime instead of a version
# string frozen into heartbeat.ps1 itself, so apply_update.ps1 can bump it
# later by rewriting just this one file.
$AgentVersion      | Set-Content -Path (Join-Path $AgentDir "agent_version.txt")       -Encoding UTF8

# Local action log (one JSON-line per PUT). Replaces silent failure.
New-Item -ItemType File -Force -Path (Join-Path $AgentDir "agent.log") | Out-Null
$AuthorizedDomains | Set-Content -Path (Join-Path $AgentDir "authorized_domains")      -Encoding UTF8

# Phase 1A — first-run flag. scan_first_run.py.frag reads it (IS_FIRST_RUN);
# the footer clears it after a successful payload print so subsequent scans
# run in lighter recurring mode.
New-Item -ItemType File -Force -Path (Join-Path $AgentDir "first_run.flag") | Out-Null

# ── Write pre-commit hook script ──────────────────────────────
# Source lives at agent/install/pre_commit_hook.ps1 and is inlined as
# base64 at render time (same INLINE_*_PS1 pattern as diagnose.ps1 below) -
# extracted out of this file so build_agent_update_bundle.py can ship it as
# part of a self-update bundle without parsing this template's own
# here-strings. Base64 (not a literal @' ... '@ here-string): a per-device
# script may itself need to write its own here-string to disk at runtime
# (scan.ps1 does, for INLINE_SCAN_PYTHON) - PowerShell here-strings cannot
# nest (ANY line starting with '@ closes whichever is currently open, with
# no escape), so splicing such a script's raw text into an outer here-string
# would prematurely close it and corrupt everything rendered after.
# Base64 has no such landmine: it's pure [A-Za-z0-9+/=], safe inside a plain
# double-quoted string with zero interpolation risk, and decodes back to the
# exact original bytes (confirmed live: a corrupted install, GSD 2026-11-11,
# traced to exactly this nesting hazard in scan.ps1 - see PatronAI#80).
$HookScript = Join-Path $AgentDir "pre_commit_hook.ps1"
[System.IO.File]::WriteAllBytes($HookScript,
    [System.Convert]::FromBase64String("{{INLINE_PRE_COMMIT_HOOK_PS1}}"))

# ── Hook-chain library (chain-aware pre-commit install) ──────
# Never clobber a pre-existing hook. Preserve it as
# pre-commit.pre-patronai and install a small chain shim that runs
# the preserved hook first, then PatronAI's PowerShell hook. Git for
# Windows runs sh.exe, so the chain shim body is a shell script even
# on Windows — same content as the Linux/macOS chain. Idempotent:
# safe to re-run from the heartbeat backstop.
$ChainLib = Join-Path $AgentDir "hook_chain.ps1"
# Source lives at agent/install/hook_chain.ps1, inlined as base64 at render
# time - extracted for the same reason as pre_commit_hook.ps1 above.
[System.IO.File]::WriteAllBytes($ChainLib,
    [System.Convert]::FromBase64String("{{INLINE_HOOK_CHAIN_PS1}}"))

# ── Auto-install into git repos under user profile (chain-aware) ─
# Confirmed customer-reported hang: on a profile with a OneDrive/cloud-sync
# folder, Get-ChildItem -Recurse touching Files-On-Demand placeholder
# reparse points can trigger an on-demand download per file, turning this
# scan into something that runs for a very long time with zero progress
# output - indistinguishable from a hang. Bounded via a background job (with
# a real timeout, unlike Get-ChildItem which has none) and OneDrive paths
# excluded outright, since a placeholder .git folder there is never a real
# repo this hook needs to reach. The job only enumerates paths - it must not
# call Install-PatronAIChainHook itself, since that function is dot-sourced
# into THIS runspace only and would not exist inside the job's own runspace.
. $ChainLib
$InstallCount = 0
try {
    $gitScanJob = Start-Job -ScriptBlock {
        param($ProfilePath)
        # -Force: git marks .git hidden on Windows; without it nothing is found.
        Get-ChildItem -Path $ProfilePath -Recurse -Depth 4 -Force -Filter ".git" -Directory -ErrorAction SilentlyContinue |
            Where-Object { $_.FullName -notmatch '(?i)\\OneDrive' } |
            Select-Object -ExpandProperty FullName
    } -ArgumentList $env:USERPROFILE
    if (Wait-Job $gitScanJob -Timeout 20) {
        foreach ($repoPath in (Receive-Job $gitScanJob)) {
            $HooksDir = Join-Path $repoPath "hooks"
            if (Install-PatronAIChainHook -HooksDir $HooksDir) { $InstallCount++ }
        }
    } else {
        Write-Info "Scanning existing repos for the pre-commit hook timed out after 20s - skipped. New repos are still auto-instrumented via init.templateDir below."
    }
    Remove-Job $gitScanJob -Force -ErrorAction SilentlyContinue
} catch { }

# Step 0.1 — git template dir (auto-install on every future init/clone).
# Honours an existing init.templateDir if one is already set (additive).
$TemplateDir   = Join-Path $AgentDir "git-template"
$TemplateHooks = Join-Path $TemplateDir "hooks"
$ExistingTpl   = (& git config --global --get init.templateDir 2>$null)
if ($ExistingTpl -and $ExistingTpl -ne $TemplateDir) {
    $Expanded = $ExistingTpl -replace '^~', $env:USERPROFILE
    $TgtHooks = Join-Path $Expanded "hooks"
    # Install the sh chain shim (never the raw .ps1: Git for Windows runs
    # hooks through sh.exe, so a PowerShell body breaks every commit in
    # every repo cloned from this template). Chain-aware: a hook already
    # in the user's template is preserved and still runs first.
    [void](Install-PatronAIChainHook -HooksDir $TgtHooks)
    Write-Info "init.templateDir preserved ($ExistingTpl); hook chained alongside."
} else {
    [void](Install-PatronAIChainHook -HooksDir $TemplateHooks)
    & git config --global init.templateDir $TemplateDir | Out-Null
    Write-Info "init.templateDir set - every new git init/clone gets the hook."
}

# ── Write endpoint scan script ────────────────────────────────
# Runs every 30 min. Multi-surface: packages, processes, browsers,
# IDE plugins, containers (image+logs), shell history. Scan logic
# lives in agent/install/scan_*.py.frag — same Python is inlined
# into agent/install/scan.ps1 at render time (render_agent_package.py
# resolves scan.ps1's own {{ INLINE_SCAN_PYTHON }} placeholder BEFORE this
# outer substitution pass, since a nested {{...}} inside a substituted
# value is not re-scanned by the same pass — see that file's comment).
# scan.ps1 is extracted to its own file for the same reason
# pre_commit_hook.ps1/hook_chain.ps1 are above. Base64, not a here-string:
# scan.ps1 writes INLINE_SCAN_PYTHON to disk via its OWN @' ... '@ block at
# runtime, and that inner closing '@ would prematurely end an outer
# here-string wrapping this whole section verbatim (see pre_commit_hook.ps1
# above for the full explanation).
$ScanScript = Join-Path $AgentDir "scan.ps1"
[System.IO.File]::WriteAllBytes($ScanScript,
    [System.Convert]::FromBase64String("{{INLINE_SCAN_PS1}}"))

# ── Report install status ─────────────────────────────────────
$StatusPayload = @{
    token        = $Token
    status       = "installed"
    device_id    = $env:COMPUTERNAME
    installed_at = (Get-Date -Format "yyyy-MM-ddTHH:mm:ssZ")
} | ConvertTo-Json -Compress

try {
    Invoke-WebRequest -Uri $StatusPutUrl -Method Put -Body $StatusPayload `
        -ContentType "application/json" -TimeoutSec 15 -UseBasicParsing | Out-Null
} catch { <# non-fatal #> }

# ── Write heartbeat script (URL refresh + identity + structured log) ──
# Source lives at agent/install/heartbeat.ps1, inlined as base64 at render
# time - extracted for the same reason as the scripts above.
$HeartbeatScript = Join-Path $AgentDir "heartbeat.ps1"
[System.IO.File]::WriteAllBytes($HeartbeatScript,
    [System.Convert]::FromBase64String("{{INLINE_HEARTBEAT_PS1}}"))

# ── Write self-update script ──────────────────────────────────
# Runs hourly, separate from the 5-min heartbeat above that only NOTICES an
# update (writes pending_update.json) - applying it is a separate, lower-
# frequency task so a scheduled heartbeat run can never read this same
# heartbeat.ps1 file half-replaced out from under itself. Source lives at
# agent/install/apply_update.ps1 and is inlined as base64 at render time -
# same INLINE_*_PS1 pattern as diagnose.ps1 below.
$ApplyUpdateScript = Join-Path $AgentDir "apply_update.ps1"
[System.IO.File]::WriteAllBytes($ApplyUpdateScript,
    [System.Convert]::FromBase64String("{{INLINE_APPLY_UPDATE_PS1}}"))

# ── Write log-rotation script (drops heartbeat entries older than 24 h) ──
# Pure Python stdlib -- no third-party deps. Source lives at
# agent/install/log_rotate.py, inlined as base64 at render time.
$LogRotateScript = Join-Path $AgentDir "log_rotate.py"
[System.IO.File]::WriteAllBytes($LogRotateScript,
    [System.Convert]::FromBase64String("{{INLINE_LOG_ROTATE_PY}}"))

# ── Hidden-launch shim ────────────────────────────────────────
# Task Scheduler invoking powershell.exe directly still briefly flashes a
# console window on many Windows builds even with -WindowStyle Hidden — the
# OS allocates a console host before PowerShell's own startup code can apply
# that style. WScript.Shell.Run with windowStyle=0 suppresses the window at
# process-creation time instead, so nothing ever flashes on screen. Every 5
# minutes was visibly popping a window; this is the fix.
# ACCEPTED RISK (PR#10 review, N1): a wscript.exe + WScript.Shell.Run hidden
# launcher is a pattern AV/EDR heuristics sometimes flag, since it's also a
# known living-off-the-land technique — ironic for a security product. If
# quarantined, the Scheduled Tasks silently stop firing with no error in the
# install log. Accepted for now over the added infra of a compiled/signed
# launcher; add an AV-exclusion note to the install runbook if this bites.
$HiddenLauncher = Join-Path $AgentDir "run_hidden.vbs"
@'
Dim shell, cmd
Set shell = CreateObject("WScript.Shell")
cmd = "powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File " & Chr(34) & WScript.Arguments(0) & Chr(34)
shell.Run cmd, 0, False
'@ | Set-Content -Path $HiddenLauncher -Encoding ASCII

# ── Register Task Scheduler tasks ────────────────────────────
function Register-PatronAITask($TaskName, $ScriptPath, $IntervalMinutes, $Desc) {
    $Action   = New-ScheduledTaskAction -Execute "wscript.exe" `
        -Argument "//B `"$HiddenLauncher`" `"$ScriptPath`""
    $Trigger  = New-ScheduledTaskTrigger -RepetitionInterval (New-TimeSpan -Minutes $IntervalMinutes) `
        -Once -At (Get-Date)
    $Settings = New-ScheduledTaskSettingsSet -ExecutionTimeLimit (New-TimeSpan -Minutes 2) `
        -StartWhenAvailable -DontStopIfGoingOnBatteries -RunOnlyIfNetworkAvailable -Hidden
    try {
        Unregister-ScheduledTask -TaskName $TaskName -Confirm:$false -ErrorAction SilentlyContinue
        Register-ScheduledTask -TaskName $TaskName -Action $Action -Trigger $Trigger `
            -Settings $Settings -Description $Desc -RunLevel Limited | Out-Null
        Write-Info "$TaskName registered (every $IntervalMinutes min)."
    } catch {
        Write-Info "$TaskName registration failed: $_"
    }
}

Register-PatronAITask "PatronAI-Heartbeat"   $HeartbeatScript   5  "PatronAI liveness heartbeat"
Register-PatronAITask "PatronAI-Scan"        $ScanScript        30 "PatronAI endpoint scan (packages/processes/browser)"
Register-PatronAITask "PatronAI-LogRotate"   $LogRotateScript   1440 "PatronAI agent log rotation (drops heartbeat entries older than 24h)"
Register-PatronAITask "PatronAI-Update"      $ApplyUpdateScript 60 "PatronAI agent self-update"

# Run first scan immediately in background. Fire-and-forget by design (no
# -Wait -- the scan's own result surfaces later via its scheduled task), but
# -PassThru (via the shared wrapper) still confirms the process actually
# started rather than silently discarding that signal, consistent with
# every other process launch in this codebase after the WOW64 postmortem.
Start-RavenProcess -FilePath wscript.exe -ArgumentList @("//B", "`"$HiddenLauncher`"", "`"$ScanScript`"") | Out-Null

Remove-Item -Path $TmpMeta -ErrorAction SilentlyContinue

# ── Drop the recipient-side diagnose script ──────────────────
$Diag = Join-Path $AgentDir "diagnose.ps1"
[System.IO.File]::WriteAllBytes($Diag,
    [System.Convert]::FromBase64String("{{INLINE_DIAGNOSE_PS1}}"))

Write-Host ""
Write-Info "Installation complete."
Write-Info "Pre-commit hook installed in $InstallCount existing repositories."
Write-Info "New repos auto-instrumented via init.templateDir - no manual step needed."
Write-Info "Endpoint scan every 30 min - packages, processes, browsers, IDE plugins, containers, shell history,"
Write-Info "                              MCP servers, agent workflows, scheduled agents, tool registrations, vector DBs."
Write-Info "First scan runs in baseline mode (wider walk); subsequent scans run lighter."
Write-Info "Heartbeat every 5 min - refreshes presigned URLs AND auto-installs the pre-commit hook"
Write-Info "                       in any new git repo cloned/init-ed since the last cycle."
Write-Info "AI framework signals in git commits will be forwarded for analysis."
Write-Info "If anything looks off later, run:  powershell -File ~/.patronai/diagnose.ps1"
