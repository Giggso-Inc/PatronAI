#!/usr/bin/env bash
# =============================================================
# PatronAI — Agent Uninstaller (Mac / Linux)
# Recipient:  {{RECIPIENT_NAME}} <{{RECIPIENT_EMAIL}}>
# Company:    {{COMPANY}}
# Token:      {{TOKEN}}
# Generated:  {{EXPIRES_AT}}
# =============================================================
# Removes all hooks, schedulers, and agent files.
# Safe to run multiple times. No sudo required.
# USAGE: bash uninstall_agent.sh
# =============================================================

_info() { echo "[patronai] $*"; }
_ok()   { echo "[patronai] ✓ $*"; }

echo ""
echo "PatronAI Agent Uninstaller"
echo "=========================="
echo "Recipient : {{RECIPIENT_NAME}} <{{RECIPIENT_EMAIL}}>"
echo "Company   : {{COMPANY}}"
echo "Token     : {{TOKEN}}"
echo ""
echo "This will remove the PatronAI agent from this machine."
echo "Your code and git repos are not affected."
echo ""
read -rp "Continue? [y/N] " CONFIRM
[[ "$CONFIRM" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 0; }
echo ""

AGENT_DIR="$HOME/.patronai"

# ── 1. Stop and remove launchd jobs (Mac) ────────────────────
if [ "$(uname -s)" = "Darwin" ]; then
  for LABEL in com.patronai.heartbeat com.patronai.scan com.patronai.update com.patronai.log-rotate; do
    PLIST="$HOME/Library/LaunchAgents/${LABEL}.plist"
    if [ -f "$PLIST" ]; then
      launchctl unload "$PLIST" 2>/dev/null || true
      rm -f "$PLIST"
      _ok "Removed launchd job: $LABEL"
    fi
  done
fi

# ── 2. Remove crontab entries (Linux) ────────────────────────
if [ "$(uname -s)" != "Darwin" ]; then
  if crontab -l 2>/dev/null | grep -q patronai; then
    crontab -l 2>/dev/null | grep -v patronai | crontab -
    _ok "Removed crontab entries"
  fi
fi

# ── 3. Remove git pre-commit hooks ───────────────────────────
HOOK_SCRIPT="$AGENT_DIR/pre_commit_hook.sh"
REMOVED=0
# [2026-11-11] This only ever handled the OLD symlink-based hook: it required
# the hook to be a SYMLINK pointing at $AGENT_DIR/pre_commit_hook.sh, and
# restored a sibling named "pre-commit.backup". The installer has since moved
# to the chain form (lib hook_chain.sh): it writes pre-commit as a REGULAR
# FILE carrying the marker below, and preserves any pre-existing hook as
# "pre-commit.pre-patronai". All three assumptions are now wrong, so the
# uninstaller matched nothing and left the hook in place - pointing at a
# pre_commit_hook script it had just deleted.
#
# Confirmed live: after uninstalling, EVERY git commit in EVERY repo PatronAI
# had instrumented failed with
#   The argument '<home>/.patronai/pre_commit_hook.ps1' to the -File parameter
#   does not exist.
# which names neither PatronAI nor the uninstall as the cause. Reproduced in
# two separate repositories on the same machine; one install reported
# instrumenting 8 repositories.
#
# Handle BOTH forms: the legacy symlink, and the chain file (restoring
# pre-commit.pre-patronai when it exists, otherwise removing outright).
HOOK_MARKER="PatronAI managed pre-commit chain"
while IFS= read -r -d '' GIT_DIR; do
  HOOK_PATH="$GIT_DIR/hooks/pre-commit"
  PRESERVED="$GIT_DIR/hooks/pre-commit.pre-patronai"
  IS_OURS=0

  # Legacy: symlink -> $AGENT_DIR/pre_commit_hook.sh
  if [ -L "$HOOK_PATH" ] && [ "$(readlink "$HOOK_PATH")" = "$HOOK_SCRIPT" ]; then
    IS_OURS=1
  # Current: regular chain file, identified by its own marker. Match on the
  # marker rather than on the interpreter path, so this stays correct for the
  # .sh and .ps1 variants alike.
  elif [ -f "$HOOK_PATH" ] && grep -qs "$HOOK_MARKER" "$HOOK_PATH"; then
    IS_OURS=1
  fi

  if [ "$IS_OURS" -eq 1 ]; then
    rm -f "$HOOK_PATH"
    if [ -f "$PRESERVED" ]; then
      mv "$PRESERVED" "$HOOK_PATH"
      _ok "Restored pre-existing hook in: $(dirname "$GIT_DIR")"
    elif [ -f "${HOOK_PATH}.backup" ]; then
      mv "${HOOK_PATH}.backup" "$HOOK_PATH"
      _ok "Restored original hook in: $(dirname "$GIT_DIR")"
    else
      _ok "Removed hook from: $(dirname "$GIT_DIR")"
    fi
    REMOVED=$((REMOVED + 1))
  fi
done < <(find "$HOME" -maxdepth 6 -name ".git" -type d -print0 2>/dev/null)
_info "Hooks removed from $REMOVED repositories."

# ── 4. Unwire git template dir ────────────────────────────────
TPL=$(git config --global --get init.templateDir 2>/dev/null || echo "")
if [ "$TPL" = "$AGENT_DIR/git-template" ]; then
  git config --global --unset init.templateDir 2>/dev/null || true
  _ok "Cleared init.templateDir (was $TPL)"
elif [ -n "$TPL" ]; then
  EXP="${TPL/#~/$HOME}"
  if [ -L "$EXP/hooks/pre-commit" ] && \
     [ "$(readlink "$EXP/hooks/pre-commit" 2>/dev/null)" = "$AGENT_DIR/pre_commit_hook.sh" ]; then
    rm -f "$EXP/hooks/pre-commit"
    _ok "Removed PatronAI hook from external templateDir ($TPL)"
  fi
fi

# ── 5. Remove agent directory ─────────────────────────────────
if [ -d "$AGENT_DIR" ]; then
  rm -rf "$AGENT_DIR"
  _ok "Removed $AGENT_DIR"
fi

echo ""
_info "Uninstall complete. No agent files remain on this machine."
_info "Your IT administrator will confirm server-side deregistration."
