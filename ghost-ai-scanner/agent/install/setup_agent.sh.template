#!/usr/bin/env bash
# =============================================================
# PatronAI — Agent Installer (Mac / Linux)
# Generated for: {{RECIPIENT_NAME}} <{{RECIPIENT_EMAIL}}>
# Token: {{TOKEN}}
# Expires: {{EXPIRES_AT}}
# USAGE: bash setup_agent.sh
# =============================================================
set -euo pipefail

META_URL="{{META_URL}}"
STATUS_PUT_URL="{{STATUS_PUT_URL}}"
HEARTBEAT_PUT_URL="{{HEARTBEAT_PUT_URL}}"
SCAN_PUT_URL="{{SCAN_PUT_URL}}"
AUTHORIZED_GET_URL="{{AUTHORIZED_GET_URL}}"
URLS_REFRESH_URL="{{URLS_REFRESH_URL}}"
AUTHORIZED_DOMAINS="{{AUTHORIZED_DOMAINS}}"
BUCKET="{{BUCKET}}"
REGION="{{REGION}}"
COMPANY="{{COMPANY}}"
TOKEN="{{TOKEN}}"
RECIPIENT_EMAIL="{{RECIPIENT_EMAIL}}"
AGENT_VERSION="{{AGENT_VERSION}}"
AGENT_DIR="$HOME/.patronai"

_die()  { echo "ERROR: $*" >&2; exit 1; }
_info() { echo "[patronai] $*"; }

# ── Dependencies ──────────────────────────────────────────────
# Checked up front, all at once. These were previously discovered by dying
# part-way through: git at the init.templateDir step (~line 250) and crontab at
# the scheduling step (~line 450), both AFTER the code had been validated and
# config written, leaving a half-installed agent behind.
_MISSING=""
command -v curl    >/dev/null 2>&1 || _MISSING="$_MISSING\n  - curl"
command -v python3 >/dev/null 2>&1 || _MISSING="$_MISSING\n  - python3"
command -v git     >/dev/null 2>&1 || _MISSING="$_MISSING\n  - git      (the pre-commit hook is installed via git config init.templateDir)"
if [ -n "$_MISSING" ]; then
  echo "ERROR: PatronAI needs the following, which are missing:" >&2
  printf '%b\n' "$_MISSING" >&2
  echo "Install them and re-run this installer." >&2
  exit 1
fi
# crontab is checked but NOT fatal - it only schedules the heartbeat and periodic
# scan. Losing those is worth a warning, not a failed install with the agent and
# git hook already in place.
_HAVE_CRON=1
command -v crontab >/dev/null 2>&1 || _HAVE_CRON=0

# $PY is the interpreter that can import bcrypt, used for the code check below.
# Unchanged fast path: when the system python3 already has bcrypt, PY stays
# python3 and this block does nothing at all.
PY=python3
if ! $PY -c "import bcrypt" 2>/dev/null; then
  _info "Installing bcrypt..."
  if pip3 install --quiet "bcrypt>=4.0.0" 2>/dev/null && $PY -c "import bcrypt" 2>/dev/null; then
    :
  else
    # PEP 668: Debian 12+, Ubuntu 23.04+ and Fedora 38+ refuse system-wide pip
    # installs into the OS interpreter ("externally managed environment"), so the
    # old unconditional `pip3 install || _die` aborted the installer on every
    # current distro. A private venv keeps the host interpreter untouched, which
    # is what PEP 668 is protecting - preferable to --break-system-packages.
    _info "System-wide install refused (PEP 668) - using a private virtualenv instead."
    mkdir -p "$AGENT_DIR"
    python3 -m venv "$AGENT_DIR/.venv" >/dev/null 2>&1 \
      || _die "Cannot create a virtualenv at $AGENT_DIR/.venv. On Debian/Ubuntu: sudo apt-get install -y python3-venv"
    "$AGENT_DIR/.venv/bin/pip" install --quiet "bcrypt>=4.0.0" \
      || _die "Cannot install bcrypt into $AGENT_DIR/.venv."
    PY="$AGENT_DIR/.venv/bin/python"
  fi
fi

# ── OTP prompt (accepts non-interactive OTP via env var) ─────
# Standalone installs prompt the user, exactly as before. When invoked
# by Raven's installer, PATRONAI_OTP is set to the SAME 6-digit code
# the user typed into Raven; Raven Hub has already mirrored that code
# into this package's meta.json bcrypt hash (via /agent/provision
# otp_override), so the same validation below still runs — no trust
# flag, no bypass. Attacker with only the .sh cannot install.
echo ""
echo "PatronAI — {{COMPANY}} · {{RECIPIENT_NAME}}"
echo "-------------------------------------------"
if [ -n "${PATRONAI_OTP:-}" ]; then
  OTP_INPUT="$PATRONAI_OTP"
  _info "Using OTP passed by caller (non-interactive)."
else
  read -rp "Enter your 6-digit OTP from the email: " OTP_INPUT
fi
[[ "$OTP_INPUT" =~ ^[0-9]{6}$ ]] || _die "OTP must be exactly 6 digits."

# ── Validate OTP against S3 meta ─────────────────────────────
_info "Validating..."
TMP=$(mktemp /tmp/patronai.XXXXXX.json)
trap 'rm -f "$TMP"' EXIT
curl -fsSL --max-time 30 "$META_URL" -o "$TMP" \
  || _die "Cannot reach server. Link may have expired — request a new package."
OTP_HASH=$(python3 -c "import json; print(json.load(open('$TMP'))['otp_hash'])")
EXPIRES=$(python3  -c "import json; print(json.load(open('$TMP'))['expires_at'])")
python3 -c "
from datetime import datetime,timezone
exit(1 if datetime.now(timezone.utc)>datetime.fromisoformat('$EXPIRES') else 0)
" || _die "Package expired. Request a new one from your administrator."
# $PY, not python3 - this is the one call in the script that needs a THIRD-PARTY
# module, so it has to run in whichever interpreter the dependency block above
# actually put bcrypt into. The stdlib-only calls above are fine on python3.
$PY -c "
import bcrypt
exit(0 if bcrypt.checkpw(b'$OTP_INPUT',b'$OTP_HASH') else 1)
" || _die "Invalid OTP."
_info "OTP validated."

# ── Write agent config (identity baked at install time) ──────
mkdir -p "$AGENT_DIR"
DEVICE_UUID=$(python3 -c "import uuid; print(uuid.uuid4())")
MAC_PRIMARY=$(python3 -c "import uuid; n=uuid.getnode(); print(':'.join(f'{(n>>i)&0xff:02x}' for i in (40,32,24,16,8,0)))")
python3 - <<PYCFG > "$AGENT_DIR/config.json"
import json
print(json.dumps({
  "bucket":      "$BUCKET",
  "region":      "$REGION",
  "company":     "$COMPANY",
  "token":       "$TOKEN",
  "email":       "$RECIPIENT_EMAIL",
  "device_uuid": "$DEVICE_UUID",
  "mac_primary": "$MAC_PRIMARY",
  "agent_dir":   "$AGENT_DIR",
}))
PYCFG
chmod 600 "$AGENT_DIR/config.json"

# Persist presigned URLs + URL-refresh endpoint + authorised list fallback.
# URL files are rotated daily by heartbeat.sh fetching urls.json — see Step 0.
echo "$HEARTBEAT_PUT_URL"  > "$AGENT_DIR/heartbeat_url"
echo "$SCAN_PUT_URL"       > "$AGENT_DIR/scan_url"
echo "$AUTHORIZED_GET_URL" > "$AGENT_DIR/authorized_url"
echo "$URLS_REFRESH_URL"   > "$AGENT_DIR/urls_refresh_url"
echo "$AUTHORIZED_DOMAINS" > "$AGENT_DIR/authorized_domains"
# agent_version — read by heartbeat.sh at runtime instead of a version
# string frozen into heartbeat.sh itself, so apply_update.sh can bump it
# later by rewriting just this one file.
echo "$AGENT_VERSION"      > "$AGENT_DIR/agent_version.txt"
chmod 600 "$AGENT_DIR/heartbeat_url" "$AGENT_DIR/scan_url" \
          "$AGENT_DIR/authorized_url" "$AGENT_DIR/urls_refresh_url" \
          "$AGENT_DIR/authorized_domains" "$AGENT_DIR/agent_version.txt"

# Local action log — every PUT records {ts,type,http_status,key,error}.
# Replaces silent ` || true ` swallowing — admins / IT can SCP this back.
touch "$AGENT_DIR/agent.log" && chmod 600 "$AGENT_DIR/agent.log"

# Phase 1A — drop a first-run flag so the next scan runs in baseline mode.
# scan_first_run.py.frag reads this and exposes IS_FIRST_RUN=True; the
# footer clears the flag after a successful payload print so subsequent
# 30-min recurring scans run in lighter mode.
touch "$AGENT_DIR/first_run.flag" && chmod 600 "$AGENT_DIR/first_run.flag"

# ── Write pre-commit hook script ──────────────────────────────
# Source lives at agent/install/pre_commit_hook.sh and is inlined verbatim
# at render time (same pattern as diagnose.sh below) - extracted out of this
# file so build_agent_update_bundle.py can ship it as part of a self-update
# bundle without parsing this template's own heredocs.
HOOK_SCRIPT="$AGENT_DIR/pre_commit_hook.sh"
cat > "$HOOK_SCRIPT" << 'HOOK_EOF'
{{INLINE_PRE_COMMIT_HOOK_SH}}
HOOK_EOF
chmod +x "$HOOK_SCRIPT"

# ── Write hook-chain library ──────────────────────────────────
# Chain-aware installer for .git/hooks/pre-commit. Never clobbers a
# pre-existing hook (Raven's, husky's, or user's) — preserves the old
# hook under `pre-commit.pre-patronai` and installs a small chain
# script that runs the preserved hook first, then PatronAI's hook.
# Idempotent: safe to re-run from the initial walk, the heartbeat
# backstop, and the user-invoked install_hook.sh helper.
HOOK_CHAIN_LIB="$AGENT_DIR/hook_chain.sh"
# Source lives at agent/install/hook_chain.sh, inlined verbatim at render
# time - extracted for the same reason as pre_commit_hook.sh above. Its own
# nested heredoc (CHAIN_HOOK_EOF) uses a different terminator than this
# outer one (HOOK_CHAIN_LIB's CHAIN_LIB_EOF), so nesting is unaffected by
# being inlined here as plain substituted text.
cat > "$HOOK_CHAIN_LIB" << 'CHAIN_LIB_EOF'
{{INLINE_HOOK_CHAIN_SH}}
CHAIN_LIB_EOF
chmod +x "$HOOK_CHAIN_LIB"

# ── Write install_hook.sh helper ──────────────────────────────
# User-runnable helper for repos outside the initial walk (e.g. NFS,
# external drives, private paths). Delegates to the chain library so
# behaviour is identical to the auto-install path.
INSTALL_HELPER="$AGENT_DIR/install_hook.sh"
cat > "$INSTALL_HELPER" << 'HELPER_EOF'
#!/usr/bin/env bash
# Usage: bash ~/.patronai/install_hook.sh [/path/to/repo]
REPO="${1:-$(pwd)}"
[ -d "$REPO/.git" ] || { echo "ERROR: Not a git repo: $REPO"; exit 1; }
# shellcheck disable=SC1091
source "$HOME/.patronai/hook_chain.sh"
if pa_install_chain_hook "$REPO/.git/hooks"; then
    echo "[patronai] Hook chain installed in $REPO"
else
    echo "[patronai] Hook chain install failed for $REPO" >&2
    exit 1
fi
HELPER_EOF
chmod +x "$INSTALL_HELPER"

# ── Auto-install into git repos found under HOME (chain-aware) ─
INSTALL_COUNT=0
# shellcheck disable=SC1090
source "$HOOK_CHAIN_LIB"
while IFS= read -r -d '' GIT_DIR; do
  pa_install_chain_hook "$GIT_DIR/hooks" && INSTALL_COUNT=$((INSTALL_COUNT + 1))
done < <(find "$HOME" -maxdepth 6 -name ".git" -type d -print0 2>/dev/null)

# ── Step 0.1 — git template dir (auto-install on every future init/clone) ──
# Honours an existing init.templateDir if the user already set one (additive).
EXISTING_TPL=$(git config --global --get init.templateDir 2>/dev/null || echo "")
if [ -n "$EXISTING_TPL" ] && [ "$EXISTING_TPL" != "$AGENT_DIR/git-template" ]; then
  # User already has a template — drop our hook into theirs without disturbing the rest.
  EXPANDED_TPL="${EXISTING_TPL/#~/$HOME}"
  mkdir -p "$EXPANDED_TPL/hooks"
  ln -sf "$HOOK_SCRIPT" "$EXPANDED_TPL/hooks/pre-commit"
  _info "init.templateDir preserved ($EXISTING_TPL); hook copied alongside."
else
  mkdir -p "$AGENT_DIR/git-template/hooks"
  ln -sf "$HOOK_SCRIPT" "$AGENT_DIR/git-template/hooks/pre-commit"
  git config --global init.templateDir "$AGENT_DIR/git-template"
  _info "init.templateDir set — every new git init/clone gets the hook."
fi

# ── Write endpoint scan script ────────────────────────────────
# Runs every 30 min. Checks packages, processes, browsers, IDE plugins,
# containers (image+logs), shell history. Scan logic lives in
# agent/install/scan_*.py.frag and is inlined here at render time.
# Findings matched against unauthorised list; authorised list suppresses.
SCAN_SCRIPT="$AGENT_DIR/scan.sh"
# Source lives at agent/install/scan.sh, inlined verbatim at render time.
# scan.sh's own {{ INLINE_SCAN_PYTHON }} placeholder is resolved BEFORE this
# outer substitution pass (render_agent_package.py pre-resolves it into
# INLINE_SCAN_SH's value) - a nested {{...}} inside a substituted value is
# not re-scanned by the same regex.sub() pass. See render_agent_package.py.
cat > "$SCAN_SCRIPT" << 'SCAN_EOF'
{{INLINE_SCAN_SH}}
SCAN_EOF
chmod +x "$SCAN_SCRIPT"

# Wrapper that runs scan, PUTs result, and logs the outcome (no more silent failure).
SCAN_RUNNER="$AGENT_DIR/run_scan.sh"
cat > "$SCAN_RUNNER" << RUNNER_EOF
#!/usr/bin/env bash
AGENT_DIR="\$HOME/.patronai"
LOG="\$AGENT_DIR/agent.log"
[ -f "\$AGENT_DIR/scan_url" ] || exit 0
SCAN_URL=\$(cat "\$AGENT_DIR/scan_url")
[ -z "\$SCAN_URL" ] && exit 0
RESULT=\$(bash "$SCAN_SCRIPT" 2>/dev/null)
[ -z "\$RESULT" ] && exit 0
HTTP=\$(curl -s -o /dev/null -w '%{http_code}' --max-time 30 \\
       -X PUT "\$SCAN_URL" -H 'Content-Type: application/json' -d "\$RESULT")
TS=\$(date -u +%Y-%m-%dT%H:%M:%SZ)
echo "{\"ts\":\"\$TS\",\"type\":\"scan\",\"http_status\":\$HTTP}" >> "\$LOG"
RUNNER_EOF
chmod +x "$SCAN_RUNNER"

# ── Write heartbeat script (identity-rich + URL refresh + structured log) ──
HEARTBEAT_SCRIPT="$AGENT_DIR/heartbeat.sh"
# Source lives at agent/install/heartbeat.sh, inlined verbatim at render
# time - extracted for the same reason as the scripts above.
cat > "$HEARTBEAT_SCRIPT" << 'HB_EOF'
{{INLINE_HEARTBEAT_SH}}
HB_EOF
chmod +x "$HEARTBEAT_SCRIPT"

# ── Write self-update script ──────────────────────────────────
# Runs hourly, separate from the 5-min heartbeat above that only NOTICES an
# update (writes pending_update.json) - applying it is a separate, lower-
# frequency task so a scheduled heartbeat run can never read this same
# heartbeat.sh half-replaced out from under itself. Source lives at
# agent/install/apply_update.sh and is inlined verbatim at render time -
# same pattern as diagnose.sh below.
APPLY_UPDATE_SCRIPT="$AGENT_DIR/apply_update.sh"
cat > "$APPLY_UPDATE_SCRIPT" << 'APPLY_UPDATE_EOF'
{{INLINE_APPLY_UPDATE_SH}}
APPLY_UPDATE_EOF
chmod +x "$APPLY_UPDATE_SCRIPT"

# ── Schedule heartbeat (5 min) + scan (30 min) ────────────────
if [ "$(uname -s)" = "Darwin" ]; then
  # Heartbeat — launchd, every 5 min
  PLIST_HB="$HOME/Library/LaunchAgents/com.patronai.heartbeat.plist"
  cat > "$PLIST_HB" << PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.patronai.heartbeat</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>$HEARTBEAT_SCRIPT</string></array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>$AGENT_DIR/heartbeat.log</string>
</dict></plist>
PLIST_EOF
  launchctl unload "$PLIST_HB" 2>/dev/null || true
  launchctl load  "$PLIST_HB" 2>/dev/null || true

  # Scan — launchd, every 30 min
  PLIST_SCAN="$HOME/Library/LaunchAgents/com.patronai.scan.plist"
  cat > "$PLIST_SCAN" << PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.patronai.scan</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>$SCAN_RUNNER</string></array>
  <key>StartInterval</key><integer>1800</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>$AGENT_DIR/scan.log</string>
</dict></plist>
PLIST_EOF
  launchctl unload "$PLIST_SCAN" 2>/dev/null || true
  launchctl load  "$PLIST_SCAN" 2>/dev/null || true

  # Self-update — launchd, every hour
  PLIST_UPDATE="$HOME/Library/LaunchAgents/com.patronai.update.plist"
  cat > "$PLIST_UPDATE" << PLIST_EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.patronai.update</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>$APPLY_UPDATE_SCRIPT</string></array>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardErrorPath</key><string>$AGENT_DIR/update.log</string>
</dict></plist>
PLIST_EOF
  launchctl unload "$PLIST_UPDATE" 2>/dev/null || true
  launchctl load  "$PLIST_UPDATE" 2>/dev/null || true
elif [ "$_HAVE_CRON" -eq 0 ]; then
  # No cron on this machine (common in slim container images and minimal server
  # installs). The agent, config and git hook are all in place by now, so the
  # scan-on-commit path works - only the periodic scan and heartbeat are lost.
  # Warning, not _die: dying here used to abandon a fully working install.
  _info "WARNING: crontab not found - skipping the heartbeat, periodic scan, and self-update."
  _info "         Commit-time scanning still works. To enable them: sudo apt-get install -y cron"
  _info "         then re-run this installer, or add these lines by hand:"
  _info "           */5  * * * * /bin/bash $HEARTBEAT_SCRIPT"
  _info "           */30 * * * * /bin/bash $SCAN_RUNNER"
  _info "           0    * * * * /bin/bash $APPLY_UPDATE_SCRIPT"
else
  # Linux — crontab
  # `|| true` guards against a machine with no existing crontab: `crontab -l`
  # then pipes empty input to `grep -v patronai`, which exits 1 ("no lines
  # selected"). Under `set -euo pipefail` (top of this script) that silently
  # killed the whole installer before it ever scheduled cron, reported
  # "installed" status, or ran the first scan — with no error shown.
  ( crontab -l 2>/dev/null | grep -v patronai || true
    echo "*/5  * * * * /bin/bash $HEARTBEAT_SCRIPT"
    echo "*/30 * * * * /bin/bash $SCAN_RUNNER"
    echo "0    * * * * /bin/bash $APPLY_UPDATE_SCRIPT"
  ) | crontab -
fi

# ── Report installed status ───────────────────────────────────
curl -fsSL -X PUT "$STATUS_PUT_URL" -H "Content-Type: application/json" \
  -d "{\"token\":\"$TOKEN\",\"status\":\"installed\",\"device_id\":\"$(hostname)\",\"installed_at\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}" \
  >/dev/null 2>&1 || true

# ── Run first scan immediately ────────────────────────────────
bash "$SCAN_RUNNER" &

# ── Drop the recipient-side diagnose script ──────────────────
DIAG="$AGENT_DIR/diagnose.sh"
cat > "$DIAG" << 'DIAG_EOF'
{{INLINE_DIAGNOSE_SH}}
DIAG_EOF
chmod +x "$DIAG"

echo ""
_info "Installation complete."
_info "If anything looks off later, run:  bash ~/.patronai/diagnose.sh"
_info "Pre-commit hook installed in $INSTALL_COUNT existing repo(s)."
_info "New repos auto-instrumented via init.templateDir — no manual step needed."
_info "Endpoint scan every 30 min — packages, processes, browsers, IDE plugins, containers, shell history,"
_info "                              MCP servers, agent workflows, scheduled agents, tool registrations, vector DBs."
_info "First scan runs in baseline mode (wider walk); subsequent scans run lighter."
_info "Heartbeat every 5 min — refreshes presigned URLs AND auto-installs the pre-commit hook"
_info "                       in any new git repo cloned/init-ed since the last cycle."
_info "AI framework signals in git commits will be forwarded for analysis."
