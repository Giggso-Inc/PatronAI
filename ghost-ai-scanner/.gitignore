# =============================================================
# .gitignore — ghost-ai-scanner
# =============================================================

# ── Credentials and generated configs — NEVER commit ─────────
.env
.env.*
!.env.example
packetbeat.yml
agent/config.json
grafana/datasources/s3.json

# ── Generated agent installers — NEVER commit ────────────────
# These are rendered per-recipient by scripts/render_agent_package.py
# and contain presigned S3 URLs + AWS access key IDs in query strings.
# The templates are .template; the rendered output (.sh / .ps1 without
# the suffix) is recipient-specific and goes only to S3, never to git.
agent/install/setup_agent.sh
agent/install/setup_agent.ps1
# Allow the templates explicitly (defensive — git-ignore is path-based,
# not extension-based, but make intent unambiguous):
!agent/install/setup_agent.sh.template
!agent/install/setup_agent.ps1.template

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
.pytest_cache/
.coverage
htmlcov/

# ── Generated reports (keep sample, ignore real ones) ────────
reports/regression-*.html

# ── Logs ─────────────────────────────────────────────────────
*.log

# ── Persisted multi-cloud storage secrets (provision) ────────
.patron_storage.json
.patron/
**/patron_storage.json

# ── macOS ────────────────────────────────────────────────────
.DS_Store

.codex-security-venv/
.venv/
venv/
.mypy_cache/
.ruff_cache/
# Raven Enterprise -- never commit these
.raven/manifest.secrets.json
.raven/.cache/
.model.env

# ── Vendored companion scanners (agent/scanners/) ─────────────
# Each was developed as its own standalone repo under
# D:\giggso_intern\Patron features with its own .raven/ session state
# and (for apikey-scanner) a findings database that names exactly
# which file/line on this machine holds a live secret. Neither should
# ever exist inside this tree — see agent/scanners/README.md.
agent/scanners/*/.raven/
agent/scanners/*/.apikey-scanner/
agent/scanners/*/*.egg-info/
agent/scanners/*/scan.json

# never commit TLS material or local backups
nginx/domaincert/
nginx/nginx.conf.pre-*
nginx/nginx.conf.*-backup
docker-compose.green.yml
.env.pre-*
*.pre-identity
*.pre-console*
*.pre-wsfix
*.pre-bucketfix
*.pre-summarydeny
*.pre-smtp
*.pre-minio
*.pre-cutover
*.pre-emails
